# WARNING: never spawn a bash child from this script or from the main host script.
# Privileged mode never imports functions from the environment, but the raw
# BASH_FUNC_* entries it leaves behind stay exported for the life of the process
# (invalid names cannot be held or unset), and a bash child re-imports them as live
# functions. No child of either host script may therefore be bash.

# Re-exec into privileged mode to prevent shadowing. Cannot prevent shadowed exec.
if [[ ! -o privileged ]]; then exec "$BASH" -p "$0" "$@"; fi

# Sanitise load environment
if [ -n "${BASH_ENV:-}" ] || [ -n "${LD_PRELOAD:-}" ] || [ -n "${LD_AUDIT:-}" ] || [ -n "${LD_LIBRARY_PATH:-}" ] ||
   [ -n "${GCONV_PATH:-}" ] || [ -n "${DYLD_INSERT_LIBRARIES:-}" ] || [ -n "${DYLD_LIBRARY_PATH:-}" ] ||
   [ -n "${DYLD_FALLBACK_LIBRARY_PATH:-}" ]; then
    unset BASH_ENV LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH GCONV_PATH \
        DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH DYLD_FALLBACK_LIBRARY_PATH
    exec "$0" "$@"
fi

# Whitelist-based environment cleanup. Keep vars needed for the Parcel host itself, and GPG
# (pinentry etc) downstream requirements. Please open an issue if you need more than this.
for PARCEL_ENV_VAR in $(compgen -e); do
    case "$PARCEL_ENV_VAR" in
        HOME|XDG_CONFIG_HOME|PATH|PASSWORD_STORE_DIR|GNUPGHOME) ;;
        GPG_TTY|TERM|TERMINFO|TERMINFO_DIRS|DISPLAY|XAUTHORITY|WAYLAND_DISPLAY) ;;
        XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS|GTK_IM_MODULE|QT_IM_MODULE|XMODIFIERS|PINENTRY_USER_DATA) ;;
        PARCEL_*|STATE_LOCK_TIMEOUT) ;;
        LANG|LC_*) ;;
        *)
            unset "$PARCEL_ENV_VAR" 2>/dev/null || true
            ;;
    esac
done
unset PARCEL_ENV_VAR

TOKEN="broadcast"
PARCEL_HOST=""
BOOTSTRAP_VERSION="4"

# Strict mode: the bootstrap is beyond the user's reach (not user-owned, directory not user-writable).
# Builtin tests only (before PATH sanitisation); must remain one self-contained function: tests extract it verbatim.
#
# @since 1.0.7
function parcel_strict_mode_enabled() {
    local BOOTSTRAP_DIR="."
    [[ "$0" == */* ]] && BOOTSTRAP_DIR="${0%/*}"
    [ ! -O "$0" ] && [ ! -w "$BOOTSTRAP_DIR" ]
}

STRICT_BINARIES=false
if parcel_strict_mode_enabled; then STRICT_BINARIES=true; fi

# Fail closed on a broken install: a bootstrap that looks system-wide (not caller-owned, or in a
# directory the caller cannot write) yet is caller-reachable via its file, link chain, or pointee
# can be rewritten or swapped by user-level malware; abort with fix guidance rather than running
# in either mode. The walk's readlink/stat run under a sanitised PATH in the strict shapes;
# permissive shapes are already caller-controlled. Must remain one self-contained function:
# tests extract it verbatim.
#
# @since 1.0.8
function refuse_writable_system_bootstrap() {
    local BOOTSTRAP_DIR="."
    local OWNER MODE MSG=""
    [[ "$0" == */* ]] && BOOTSTRAP_DIR="${0%/*}"
    { [ -O "$0" ] && [ -w "$BOOTSTRAP_DIR" ]; } && return 0
    if [ -L "$0" ] && [ ! -w "$BOOTSTRAP_DIR" ] && [ ! -w "$0" ]; then
        # resolve and check the whole chain of a system-looking symlinked install
        local ENTRY="$0" RESOLVED NEXT DIR HOPS=0
        RESOLVED="$ENTRY"
        while true; do
            if [ "$RESOLVED" != "$ENTRY" ]; then
                DIR="${RESOLVED%/*}"
                [ -n "$DIR" ] || DIR="/"
                if [ -w "$DIR" ]; then
                    MSG="bootstrap $0 resolves through $DIR, which is writable by you but looks like a system-wide install; refusing to start. Fix with: keep the whole link chain outside caller-writable directories, or reinstall the bootstrap at user level"
                    break
                fi
            fi
            # stat without -L judges the link (or file) itself; a failed stat reads as not caller-owned
            OWNER="$(stat -c %u "$RESOLVED" 2>/dev/null || stat -f %u "$RESOLVED" 2>/dev/null)" || OWNER=""
            MODE="$(stat -c %a "$RESOLVED" 2>/dev/null || stat -f %Lp "$RESOLVED" 2>/dev/null)" || MODE=""
            if [ "$OWNER" = "$EUID" ]; then
                MSG="bootstrap $0 resolves through $RESOLVED (owner $OWNER, mode $MODE), which is owned by you but looks like a system-wide install; refusing to start. Fix with: sudo chown -h root $RESOLVED"
                break
            fi
            if [ ! -L "$RESOLVED" ]; then
                break
            fi
            # mirrors the kernel's 40-link resolution limit
            HOPS=$((HOPS + 1))
            if [ "$HOPS" -gt 40 ]; then
                MSG="bootstrap $0 has a symlink chain that is too long or cyclic; refusing to start"
                break
            fi
            NEXT="$(readlink "$RESOLVED" 2>/dev/null)" || NEXT=""
            if [ -z "$NEXT" ]; then
                MSG="bootstrap $0 cannot be resolved (link $RESOLVED cannot be read); refusing to start"
                break
            fi
            case "$NEXT" in
                /*) RESOLVED="$NEXT" ;;
                *) RESOLVED="${RESOLVED%/*}/$NEXT" ;;
            esac
        done
        if [ -n "$MSG" ]; then
            # control characters, double quotes and backslashes are stripped: jq is not yet known available
            MSG="${MSG//[[:cntrl:]]/}"
            MSG="${MSG//\"/}"
            MSG="${MSG//\\/}"
            parcel_transmit '{"token": "broadcast", "error": "'"$MSG"'"}'
            exit 1
        fi
    fi
    [ -w "$0" ] || return 0
    OWNER="$(stat -c %U "$0" 2>/dev/null || stat -f %Su "$0" 2>/dev/null || echo unknown)"
    MODE="$(stat -c %a "$0" 2>/dev/null || stat -f %Lp "$0" 2>/dev/null || echo unknown)"
    MSG="bootstrap $0 (owner $OWNER, mode $MODE) is writable by you but looks like a system-wide install; refusing to start. Fix with: sudo chown root $0 && sudo chmod 0755 $0"
    # control characters, double quotes and backslashes are stripped: jq is not yet known available
    MSG="${MSG//[[:cntrl:]]/}"
    MSG="${MSG//\"/}"
    MSG="${MSG//\\/}"
    parcel_transmit '{"token": "broadcast", "error": "'"$MSG"'"}'
    exit 1
}

# Save the invoker's PATH before any filtering: strict mode re-sanitises this original
# value (rather than the pass-1 result) so that root-owned symlinks can be kept,
# while permissive mode restores it untouched.
ORIGINAL_PATH="$PATH"

# Pass 1 of strict-mode PATH sanitisation: keep only absolute, root-owned, non-symlinked
# directories that are not writable by the caller, using bash builtins only. Must remain a
# single self-contained function: the test suite extracts it verbatim.
#
# @since 1.0.7
function parcel_strict_filter_path() {
    local FILTERED=""
    local DIR OWNER
    local -a PATH_ELEMENTS
    IFS=':' read -ra PATH_ELEMENTS <<< "$PATH"
    for DIR in "${PATH_ELEMENTS[@]}"; do
        # keep the [ ] tests appended to the chain: some bracket-alternation chains hit a bash 3.2 parse quirk
        if [[ "$DIR" == /* ]] && [ -d "$DIR" ] && [ ! -w "$DIR" ] && [ ! -O "$DIR" ] && [ ! -L "$DIR" ]; then
            FILTERED+="${FILTERED:+:}$DIR"
        fi
    done
    PATH="$FILTERED"
    hash -r
    if [ -n "$PATH" ]; then
        local STAT="" STAT_CANDIDATE
        for STAT_CANDIDATE in /usr/bin/stat /bin/stat; do
            if [ -x "$STAT_CANDIDATE" ]; then STAT="$STAT_CANDIDATE"; break; fi
        done
        # residual: on systems with no pinned stat, a PATH-resolved stat could be
        # shadowed by a directory owned by a second attacker-controlled uid
        [ -n "$STAT" ] || STAT="stat"
        FILTERED=""
        IFS=':' read -ra PATH_ELEMENTS <<< "$PATH"
        for DIR in "${PATH_ELEMENTS[@]}"; do
            OWNER="$("$STAT" -L -c %u "$DIR" 2>/dev/null || "$STAT" -L -f %u "$DIR" 2>/dev/null)" || OWNER=""
            if [ "$OWNER" = "0" ]; then
                FILTERED+="${FILTERED:+:}$DIR"
            fi
        done
        PATH="$FILTERED"
        hash -r
    fi
}

# Pass 2 of strict-mode PATH sanitisation: re-filter the invoker's original PATH, keeping
# only elements whose link and target are both root-owned and not writable by the caller.
# Must remain a single self-contained function: the test suite extracts it verbatim.
#
# @since 1.0.7
function parcel_strict_sanitise_original_path() {
    local STAT="" STAT_CANDIDATE
    for STAT_CANDIDATE in /usr/bin/stat /bin/stat; do
        if [ -x "$STAT_CANDIDATE" ]; then STAT="$STAT_CANDIDATE"; break; fi
    done
    if [ -z "$STAT" ]; then
        # residual: a PATH-resolved stat could be shadowed by a directory owned by a second attacker-controlled uid
        # no sane Linux / POSIX system lacks a stat in /usr:/usr/bin, so this is acceptable
        command -v stat >/dev/null 2>&1 || return 0
        STAT="stat"
    fi
    local FILTERED=""
    local DIR LINK_OWNER TARGET_OWNER
    local -a PATH_ELEMENTS
    IFS=':' read -ra PATH_ELEMENTS <<< "$ORIGINAL_PATH"
    for DIR in "${PATH_ELEMENTS[@]}"; do
        # keep the [ ] tests appended to the chain: some bracket-alternation chains hit a bash 3.2 parse quirk
        # -w and -d dereference symlinks, so they judge the target; stat without -L judges the link itself
        if [[ "$DIR" == /* ]] && [ -d "$DIR" ] && [ ! -w "$DIR" ]; then
            LINK_OWNER="$("$STAT" -c %u "$DIR" 2>/dev/null || "$STAT" -f %u "$DIR" 2>/dev/null)" || LINK_OWNER=""
            TARGET_OWNER="$("$STAT" -L -c %u "$DIR" 2>/dev/null || "$STAT" -L -f %u "$DIR" 2>/dev/null)" || TARGET_OWNER=""
            if [ "$LINK_OWNER" = "0" ] && [ "$TARGET_OWNER" = "0" ]; then
                FILTERED+="${FILTERED:+:}$DIR"
            fi
        fi
    done
    PATH="$FILTERED"
    hash -r
}

# Pass 1 runs in every mode: it guarantees that any tool resolved while deciding or
# enforcing mode (e.g. ownership checks) cannot be shadowed. Permissive mode then
# restores the invoker's original PATH, including caller-controlled elements.
parcel_strict_filter_path
if $STRICT_BINARIES; then
    parcel_strict_sanitise_original_path
else
    PATH="$ORIGINAL_PATH"
    hash -r
fi

# transmit message in native messaging host protocol
function parcel_transmit() {
    local LC_ALL=C
    local s=$1 n=${#1} b
    printf -v b '\\x%02x\\x%02x\\x%02x\\x%02x' \
        "$(( n       & 255 ))" \
        "$(( n >> 8  & 255 ))" \
        "$(( n >> 16 & 255 ))" \
        "$(( n >> 24 & 255 ))"
    printf '%b%s' "$b" "$s"
}

# Run the broken-install guard once parcel_transmit is defined, before any operational work.
refuse_writable_system_bootstrap

# resolve the config directory, respecting $XDG_CONFIG_HOME per the XDG Base
# Directory Specification (falls back to $HOME/.config when unset, empty, or
# not an absolute path, as the spec requires all such paths to be absolute)
if [[ "${XDG_CONFIG_HOME:-}" == /* ]]; then
    CONFIG_DIR="$XDG_CONFIG_HOME/parcel"
else
    CONFIG_DIR="$HOME/.config/parcel"
fi

# create default startup config file if it doesn't exist
PARCELRC="$CONFIG_DIR/parcelrc"
if [ ! -e "$PARCELRC" ]; then
    mkdir -p "$(dirname "$PARCELRC")"
    cat > "$PARCELRC" <<EOT
# This file was automatically generated by the parcel-host bootstrap script.
#
# When the bootstrap host is installed system-wide (owned by root rather than by you),
# the binary path overrides below (GPG/JQ/OPENSSL) must resolve to root-owned binaries
# in directories you cannot write to.

# Valid signers for the main host script which is bundled with the extension (space-separated)
#VALID_SIGNERS="88FF14D6294AF4036B7F00FF676A3C09E2E47A72 56C3E775E72B0C8B1C0C1BD0B5DB77409B11B601 82ED663067C6017BAA4BC752EB670BF2B1131683 B0908ED59A96C9882BED9A942A51761511A30253"

# Signers to revoke even if valid (space-separated, primary or subkey fingerprint)
#BLACKLIST_SIGNERS=""

# The gpg binary to use.
# Default: gpg
#GPG="gpg"

# The jq binary to use.
# Default: jq
#JQ="jq"

# The openssl binary to use.
# Default: openssl
#OPENSSL="openssl"

# Where to write the log file
#LOGFILE="\$HOME/.local/log/parcel-host.log"

# Where to persist non-sensitive runtime state (e.g. rate-limiter bucket state)
#STATEFILE="\$HOME/.config/parcel/state"

# The password store directory
#PASSWORD_STORE_DIR="\$HOME/.password-store"

# The sha256 hash of the main host script which is bundled with the extension.
# This is used to verify the integrity of the script before executing it. By
# default, this is not set, but if you wish to review any updates to the host
# script before they are executed, you can set this to the expected hash and the
# bootstrap script will verify the hash of the script before executing it.
#HOST_HASH="1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"

# The minimum host script version accepted on install. The bootstrap host
# refuses to install a candidate script whose HOST_VERSION is lower than this
# value or the minimum recorded in the state file, whichever is higher.
#MINIMUM_HOST_VERSION="0"
EOT
chmod 0600 "$PARCELRC"
fi

# check that parcelrc has the correct permissions
if [ "$PARCELRC" != "$(find "$PARCELRC" -maxdepth 1 -type f -perm 0600 2>/dev/null || true)" ]; then
    parcel_transmit '{"token": "broadcast", "error": "parcelrc file must have permissions 0600"}'
    exit 1
fi

# Environment copies of recognised keys must not flow in: the browser hands the host
# its full session environment, and only validated parcelrc content may set these.
# PASSWORD_STORE_DIR is the exception, as setting it in the session environment is
# legitimate and longstanding for pass users.
unset VALID_SIGNERS BLACKLIST_SIGNERS MINIMUM_HOST_VERSION HOST_VERSION GPG JQ OPENSSL LOGFILE STATEFILE HOST_HASH

# default paths; parcelrc may override them
LOGFILE="$HOME/.local/log/parcel-host.log"
# shellcheck disable=SC2034 # consumed by the evaluated main host script
PASSWORD_STORE_DIR="${PASSWORD_STORE_DIR:-$HOME/.password-store}"

# a signer fingerprint is exactly 40 or 64 hex characters
FPR_PATTERN='[0-9A-Fa-f]{40}([0-9A-Fa-f]{24})?'
FPR_RE="^${FPR_PATTERN}$"
# a well-formed blacklist value: empty or space-separated fingerprints
BLACKLIST_VALUE_RE="^(${FPR_PATTERN}( ${FPR_PATTERN})*)?$"

# findings collected while reading parcelrc, flushed to the log once it is open
PARCELRC_NOTES=""

# Buffer a parcelrc review note, flushed to the logfile once it is open.
#
# $1: note text
# @since 1.0.7
function parcelrc_note() {
    PARCELRC_NOTES+="[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] $1"$'\n'
}

# Report a fatal startup problem to the extension and abort. Uses static message text
# with a caller-supplied context prefix, as jq is not yet known to be available this
# early in startup; control characters, double quotes and backslashes are stripped.
#
# $1: error message
# @return never returns
# @since 1.0.7
function parcelrc_fatal() {
    local MSG="$1"
    MSG="${MSG//[[:cntrl:]]/}"
    MSG="${MSG//\"/}"
    MSG="${MSG//\\/}"
    parcel_transmit '{"token": "broadcast", "error": "'"$MSG"'"}'
    exit 1
}

# Check that a path's ownership chain is out of the caller's reach: the resolved target
# must be owned by the expected uid and not writable by the caller, every symlink in the
# chain (up to the kernel's 40-link limit) must itself be owned by the expected uid, and
# no hop's containing directory may be caller-writable (a writable directory allows a
# rename-swap even when the file itself is read-only). On failure CHAIN_ERROR describes
# the problem.
#
# $1: path to check
# $2: expected owner uid (default 0; the parameter exists so tests can run unprivileged)
# @return 0 if the chain is acceptable, 1 with CHAIN_ERROR set otherwise
# @since 1.0.8
function parcel_check_root_owned_chain() {
    local TARGET="$1" EXPECTED_UID="${2:-0}" OWNER LINK_OWNER RESOLVED NEXT DIR HOPS=0
    CHAIN_ERROR=""
    OWNER="$(stat -L -c %u "$TARGET" 2>/dev/null || stat -L -f %u "$TARGET" 2>/dev/null)" || OWNER=""
    if [ "$OWNER" != "$EXPECTED_UID" ] || [ -w "$TARGET" ]; then
        CHAIN_ERROR="$TARGET must be owned by root and not writable by you"
        return 1
    fi
    # stat -L dereferences symlinks, so a caller-owned symlink to a root-owned target
    # would pass the check above and could be repointed after startup; require the
    # link itself to be owned by the expected uid (stat without -L judges the link)
    if [ -L "$TARGET" ]; then
        LINK_OWNER="$(stat -c %u "$TARGET" 2>/dev/null || stat -f %u "$TARGET" 2>/dev/null)" || LINK_OWNER=""
        if [ "$LINK_OWNER" != "$EXPECTED_UID" ]; then
            CHAIN_ERROR="$TARGET must be owned by root, not a caller-owned symlink"
            return 1
        fi
        # walk the whole link chain: every hop must be owned by the expected uid and
        # sit outside caller-writable directories, since any caller-reachable hop can
        # be swapped between this check and the read that follows it
        RESOLVED="$TARGET"
        while [ -L "$RESOLVED" ]; do
            # mirrors the kernel's 40-link resolution limit; only reachable
            # if the chain changed after the caller's own checks
            HOPS=$((HOPS + 1))
            if [ "$HOPS" -gt 40 ]; then
                CHAIN_ERROR="cannot resolve $TARGET (symlink chain too long or cyclic)"
                return 1
            fi
            NEXT="$(readlink "$RESOLVED")" || { CHAIN_ERROR="cannot resolve $TARGET"; return 1; }
            case "$NEXT" in
                /*) RESOLVED="$NEXT" ;;
                *) RESOLVED="${RESOLVED%/*}/$NEXT" ;;
            esac
            if [ -L "$RESOLVED" ]; then
                LINK_OWNER="$(stat -c %u "$RESOLVED" 2>/dev/null || stat -f %u "$RESOLVED" 2>/dev/null)" || LINK_OWNER=""
                if [ "$LINK_OWNER" != "$EXPECTED_UID" ]; then
                    CHAIN_ERROR="$TARGET resolves through $RESOLVED, which must be owned by root"
                    return 1
                fi
            fi
            DIR="${RESOLVED%/*}"
            [ -n "$DIR" ] || DIR="/"
            if [ -w "$DIR" ]; then
                if [ -L "$RESOLVED" ]; then
                    CHAIN_ERROR="$TARGET resolves through $DIR, a directory writable by you"
                else
                    CHAIN_ERROR="$TARGET resolves into a directory writable by you"
                fi
                return 1
            fi
        done
    fi
    local TARGET_DIR="${TARGET%/*}"
    [ -n "$TARGET_DIR" ] || TARGET_DIR="/"
    if [ -w "$TARGET_DIR" ]; then
        CHAIN_ERROR="$TARGET is in a directory writable by you"
        return 1
    fi
    return 0
}

# Check a binary value: either a bare command name (resolved via the inherited PATH) or
# an absolute path to an existing, executable regular file. In strict mode the resolved
# file must additionally pass parcel_check_root_owned_chain.
#
# $1: label naming the tool and its source, e.g. "parcelrc GPG setting" or "bootstrap gpg default"
# $2: value to check
# @return 0 if usable; reports a fatal error and exits otherwise
# @since 1.0.7
function parcelrc_check_binary() {
    local KEY="$1" VALUE="$2" TARGET
    if [[ "$VALUE" == /* ]]; then
        TARGET="$VALUE"
    elif [[ "$VALUE" =~ ^[A-Za-z0-9+._-]+$ ]]; then
        if ! $STRICT_BINARIES; then return 0; fi
        TARGET="$(command -v "$VALUE")" || parcelrc_fatal "$KEY: cannot resolve command name $VALUE"
    else
        parcelrc_fatal "$KEY: must be a command name or an absolute path"
    fi
    if [ ! -f "$TARGET" ] || [ ! -x "$TARGET" ]; then
        parcelrc_fatal "$KEY: $TARGET is not an executable file"
    fi
    if $STRICT_BINARIES; then
        if ! parcel_check_root_owned_chain "$TARGET"; then
            parcelrc_fatal "$KEY: $CHAIN_ERROR (the bootstrap host is installed system-wide)"
        fi
    fi
    return 0
}

# Validate one recognised parcelrc setting and stage it for application. Unknown keys
# are ignored so that newer parcelrc options remain forward-compatible with older
# bootstrap versions; empty values mean "keep the default". Staged keys are recorded
# in PARCELRC_KEYS_SET so the caller can tell which file a winning value came from.
#
# $1: key, $2: value, $3: source label used in log notes (optional)
# @return 0 if staged for application, 1 if ignored
# @since 1.0.7
function parcelrc_apply() {
    local KEY="$1" VALUE="$2" SRC="${3:-parcelrc}"
    [ -n "$VALUE" ] || return 1
    case "$KEY" in
        VALID_SIGNERS)
            [[ "$VALUE" =~ ^${FPR_PATTERN}( ${FPR_PATTERN})*$ ]] ||
                parcelrc_fatal "$SRC: VALID_SIGNERS must be a space-separated list of key fingerprints"
            ;;
        BLACKLIST_SIGNERS)
            if [[ ! "$VALUE" =~ $BLACKLIST_VALUE_RE ]]; then
                parcelrc_note "$SRC: BLACKLIST_SIGNERS is malformed; ignoring it"
                return 1
            fi
            ;;
        HOST_HASH)
            [[ "$VALUE" =~ ^[0-9A-Fa-f]{64}$ ]] ||
                parcelrc_fatal "$SRC: HOST_HASH must be a 64-character hex sha256 hash"
            ;;
        MINIMUM_HOST_VERSION)
            if [[ ! "$VALUE" =~ ^[0-9]{1,9}$ ]]; then
                parcelrc_note "$SRC: MINIMUM_HOST_VERSION is malformed; ignoring it"
                return 1
            fi
            ;;
        LOGFILE | STATEFILE | PASSWORD_STORE_DIR)
            case "$VALUE" in
                /* | \$HOME | \$HOME/* | \$\{HOME\} | \$\{HOME\}/*) ;;
                *)
                    parcelrc_note "$SRC: $KEY must be an absolute path (or begin with \$HOME); ignoring it"
                    return 1
                    ;;
            esac
            ;;
        GPG | JQ | OPENSSL)
            # a shape-malformed value can never be a valid override, so it is fatal
            # in either file (failing loud surfaces tampering); ownership and
            # executability of the winning value are validated post-merge at the
            # call site, so a broken override that loses does not abort startup
            local EXPANDED="${VALUE//\$\{HOME\}/$HOME}"
            EXPANDED="${EXPANDED//\$HOME/$HOME}"
            if [[ "$EXPANDED" != /* ]] && [[ ! "$EXPANDED" =~ ^[A-Za-z0-9+._-]+$ ]]; then
                parcelrc_fatal "$SRC: $KEY must be a command name or an absolute path"
            fi
            ;;
        *)
            return 1
            ;;
    esac
    PARCELRC_SANITISED+="${KEY}=\"${VALUE}\""$'\n'
    PARCELRC_KEYS_SET+="$KEY "
    return 0
}

# Check that a system parcelrc is safe to honour: it must be a regular file whose
# ownership chain passes parcel_check_root_owned_chain, it must not be writable by
# group or other, and its containing directory (with ancestors dereferenced, as e.g.
# macOS symlinks /etc to /private/etc) must be owned by the expected uid. Any failure
# is fatal: the file's existence is an assertion of admin intent, so mistakes fail
# loudly rather than being silently ignored.
#
# $1: path to check
# $2: expected owner uid (default 0; the parameter exists so tests can run unprivileged)
# @return 0 if acceptable; reports a fatal error and exits otherwise
# @since 1.0.8
function parcelrc_system_file_ok() {
    local FILE="$1" EXPECTED_UID="${2:-0}" MODE DIR DIR_OWNER
    [ -e "$FILE" ] || [ -L "$FILE" ] || parcelrc_fatal "$FILE: not found"
    [ -f "$FILE" ] || parcelrc_fatal "$FILE: not a regular file"
    # the host runs unprivileged even for system-wide installs, so a root-only-moded
    # file must fail here with a clear message rather than later as "unable to read"
    [ -r "$FILE" ] || parcelrc_fatal "$FILE: not readable by the invoking user"
    if ! parcel_check_root_owned_chain "$FILE" "$EXPECTED_UID"; then
        parcelrc_fatal "$FILE: $CHAIN_ERROR"
    fi
    MODE="$(stat -L -c %a "$FILE" 2>/dev/null || stat -L -f %Lp "$FILE" 2>/dev/null)" || MODE=""
    MODE="${MODE: -3}"
    if [ -z "$MODE" ] || (( 8#$MODE & 022 )); then
        parcelrc_fatal "$FILE: must not be writable by group or other"
    fi
    DIR="${FILE%/*}"
    [ -n "$DIR" ] || DIR="/"
    DIR_OWNER="$(stat -L -c %u "$DIR" 2>/dev/null || stat -L -f %u "$DIR" 2>/dev/null)" || DIR_OWNER=""
    if [ "$DIR_OWNER" != "$EXPECTED_UID" ]; then
        parcelrc_fatal "$FILE: containing directory $DIR must be owned by root"
    fi
    return 0
}

# Load startup config from a parcelrc file. The file is read into memory and each line
# is validated against a strict whitelist (comments, blank lines, or canonical
# KEY="value" for a recognised key); only those validated assignments are then eval'd,
# which preserves $HOME expansion in values without executing arbitrary content.
# PARCELRC_KEYS_SET records which keys were staged, for winner provenance.
#
# $1: path to the parcelrc file
# $2: source label used in log notes and fatal errors
# @since 1.0.7
function load_parcelrc() {
    local FILE="$1" SRC="$2"
    local CONTENT LINE NAME VALUE STRIPPED
    local N=0
    local ASSIGN_RE='^([A-Za-z_][A-Za-z0-9_]*)="([^"]*)"$'
    local HOMEVAR_RE='[$]HOME[A-Za-z0-9_]'
    PARCELRC_SANITISED=""
    PARCELRC_KEYS_SET=""
    CONTENT="$(head -c 1048576 "$FILE")" || parcelrc_fatal "unable to read $FILE"
    while IFS= read -r LINE || [ -n "$LINE" ]; do
        N=$((N + 1))
        [[ "$LINE" =~ ^[[:space:]]*$ ]] && continue
        [[ "$LINE" =~ ^[[:space:]]*# ]] && continue
        if [[ ! "$LINE" =~ $ASSIGN_RE ]]; then
            parcelrc_note "$SRC: ignoring unrecognised content at line $N"
            continue
        fi
        NAME="${BASH_REMATCH[1]}"
        VALUE="${BASH_REMATCH[2]}"
        # PATH was a documented option before the whitelist parser; warn on its
        # removal rather than ignoring the line without explanation
        if [ "$NAME" = "PATH" ]; then
            parcelrc_note "$SRC: PATH is no longer a parcelrc option; ignoring it (set GPG/JQ/OPENSSL to a command name or absolute path instead)"
            continue
        fi
        # values may not contain backticks, backslashes or control characters, and the
        # only permitted expansion tokens are $HOME and ${HOME}
        # shellcheck disable=SC1003 # the single-quoted backtick pattern is intentional
        case "$VALUE" in
            *'`'* | *'\'* | *[[:cntrl:]]*)
                parcelrc_note "$SRC: ignoring unsafe value at line $N"
                continue
                ;;
        esac
        STRIPPED="${VALUE//\$\{HOME\}/}"
        if [[ "$STRIPPED" =~ $HOMEVAR_RE ]]; then
            parcelrc_note "$SRC: ignoring unsafe value at line $N"
            continue
        fi
        STRIPPED="${STRIPPED//\$HOME/}"
        if [[ "$STRIPPED" == *'$'* ]]; then
            parcelrc_note "$SRC: ignoring unsafe value at line $N"
            continue
        fi
        # ignored settings return 1; do not let that abort the load
        parcelrc_apply "$NAME" "$VALUE" "$SRC" || true
    done <<< "$CONTENT"
    eval "$PARCELRC_SANITISED"
    unset PARCELRC_SANITISED
}

# Merge the user-parcelrc snapshots into the effective values after the system
# parcelrc has clobbered them: the blacklist unions (root can only add revocations,
# never remove the user's) and the host version floor takes the higher value (a system
# file can ratchet the floor but never loosen what the user set). Expects
# USER_BLACKLIST and USER_MINVER to hold the pre-system-load snapshots and
# SYSTEM_KEYS_SET to list the keys staged from the system parcelrc (empty when there
# is none; the union only runs when the system file set its own blacklist).
#
# @since 1.0.8
function parcelrc_merge_user_values() {
    if [ -n "$USER_BLACKLIST" ] && [[ " $SYSTEM_KEYS_SET " == *" BLACKLIST_SIGNERS "* ]]; then
        BLACKLIST_SIGNERS="${BLACKLIST_SIGNERS:+$BLACKLIST_SIGNERS }$USER_BLACKLIST"
    fi
    # both inputs were individually validated on staging, so a malformed union
    # indicates a bug rather than user input; fail loudly
    if [[ ! "${BLACKLIST_SIGNERS:-}" =~ $BLACKLIST_VALUE_RE ]]; then
        parcelrc_fatal "merged BLACKLIST_SIGNERS is malformed"
    fi
    MINIMUM_HOST_VERSION="${MINIMUM_HOST_VERSION:-0}"
    if (( 10#$USER_MINVER > 10#$MINIMUM_HOST_VERSION )); then
        MINIMUM_HOST_VERSION="$USER_MINVER"
    fi
}

# Validate the effective GPG/JQ/OPENSSL overrides once precedence between the user and
# system parcelrc is settled: each set value is checked exactly once, labelled with the
# file that won. A broken override that lost to the other file no longer aborts startup.
# Expects SYSTEM_KEYS_SET to list the keys staged from the system parcelrc (empty when
# there is none).
#
# @since 1.0.8
function parcelrc_check_effective_binaries() {
    local TOOL EXPANDED
    for TOOL in GPG JQ OPENSSL; do
        if [ -n "${!TOOL:-}" ]; then
            EXPANDED="${!TOOL//\$\{HOME\}/$HOME}"
            EXPANDED="${EXPANDED//\$HOME/$HOME}"
            case " $SYSTEM_KEYS_SET " in
                *" $TOOL "*) parcelrc_check_binary "$SYSTEM_PARCELRC: $TOOL setting" "$EXPANDED" ;;
                *) parcelrc_check_binary "$PARCELRC: $TOOL setting" "$EXPANDED" ;;
            esac
        fi
    done
}

# The system parcelrc anchors the trust policy outside user-writable space: every
# setting in it clobbers the user parcelrc (except BLACKLIST_SIGNERS, which unions, and
# MINIMUM_HOST_VERSION, which takes the higher value). The path is a hardcoded literal
# with no environment override, so user-level malware cannot redirect the trust anchor.
SYSTEM_PARCELRC="/etc/parcelrc"
load_parcelrc "$PARCELRC" "$PARCELRC"
USER_BLACKLIST="${BLACKLIST_SIGNERS:-}"
USER_MINVER="${MINIMUM_HOST_VERSION:-0}"
SYSTEM_KEYS_SET=""
if [ -e "$SYSTEM_PARCELRC" ] || [ -L "$SYSTEM_PARCELRC" ]; then
    parcelrc_system_file_ok "$SYSTEM_PARCELRC"
    load_parcelrc "$SYSTEM_PARCELRC" "$SYSTEM_PARCELRC"
    SYSTEM_KEYS_SET="$PARCELRC_KEYS_SET"
fi
unset PARCELRC_KEYS_SET
parcelrc_merge_user_values
parcelrc_check_effective_binaries
unset USER_BLACKLIST USER_MINVER SYSTEM_KEYS_SET

# In strict mode, check the effective binary for every tool (parcelrc override or the
# bare-name default resolved via the sanitised PATH) against the ownership bar.
if $STRICT_BINARIES; then
    for TOOL in gpg jq openssl; do
        VAR="$(tr '[:lower:]' '[:upper:]' <<< "$TOOL")"
        parcelrc_check_binary "bootstrap $TOOL default" "${!VAR:-$TOOL}"
    done
    unset TOOL VAR
fi

mkdir -p "$(dirname "$LOGFILE")"
exec 5>>"$LOGFILE"
exec 2>&5
chmod 0600 "$LOGFILE"
if [ -n "$PARCELRC_NOTES" ]; then printf '%s' "$PARCELRC_NOTES" >&5; fi
unset PARCELRC_NOTES
if [ -z "$VALID_SIGNERS" ]; then VALID_SIGNERS="88FF14D6294AF4036B7F00FF676A3C09E2E47A72 56C3E775E72B0C8B1C0C1BD0B5DB77409B11B601 82ED663067C6017BAA4BC752EB670BF2B1131683 B0908ED59A96C9882BED9A942A51761511A30253"; fi

# GPG emits uppercase fingerprints; normalise config lists so comparisons match exactly
VALID_SIGNERS="$(tr '[:lower:]' '[:upper:]' <<< "$VALID_SIGNERS")"

# resolve the state file (also overridable via parcelrc)
STATEFILE="${STATEFILE:-$CONFIG_DIR/state}"

# capture the parcelrc blacklist separately so the state-file list can be
# combined with it rather than clobbered
PARCELRC_BLACKLIST="$(tr '[:lower:]' '[:upper:]' <<< "${BLACKLIST_SIGNERS:-}")"
if [[ ! "$PARCELRC_BLACKLIST" =~ $BLACKLIST_VALUE_RE ]]; then
    printf '[%s] parcelrc BLACKLIST_SIGNERS is malformed; ignoring it\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" >&5
    PARCELRC_BLACKLIST=""
fi

# effective revocation list (state-file value, then the shipped list)
BLACKLIST_SIGNERS=""

# effective host version floor: the higher of the parcelrc value and the
# state-file value, combined by load_version_floor
MINIMUM_HOST_VERSION="${MINIMUM_HOST_VERSION:-0}"

if [ -n "$GPG" ]; then function gpg() { "$GPG" "$@"; return $?; }; fi
if [ -n "$JQ" ]; then function jq() { "$JQ" "$@"; return $?; }; fi

# Ensure we have a usable sha256
SHA256="$(command -v sha256sum || command -v sha256)"


# sender for errors
# $1: error message
# $2: optional exit code
function parcel_error() {
    if [ ${#1} -gt 0 ]; then
        parcel_transmit "$(jq -n --arg token "$TOKEN" --arg msg "$1" '{token: $token, error: $msg}')"
    fi
    if [ -n "$2" ]; then
        exit "$2"
    fi
}

# sender for regular messages
# $1: message (JSON object)
function parcel_send() {
    if [ ${#1} -gt 0 ]; then
        parcel_transmit "$(jq --arg token "$TOKEN" '{token: $token, data: .}' <<< "$1")"
    fi
}

# Load the signer blacklist from the state file, or its locked variant.
# Unknown state lines are ignored: only the blacklist value is validated, so
# future state fields can't break the bootstrap. Missing files, bad
# permissions, or a malformed value leave the blacklist empty. The value
# stands only until the next install; durable revocations belong in parcelrc.
#
# @return 0 always; problems are logged, not reported.
# @since 1.0.7
function load_blacklist() {
    # deliberately lockless to keep the bootstrap simple: a mid-save read fails validation and fails open
    local FILE="$STATEFILE"
    if [ ! -e "$FILE" ] && [ -e "$STATEFILE.locked" ]; then
        FILE="$STATEFILE.locked"
    fi
    [ -e "$FILE" ] || return 0
    if [ "$FILE" != "$(find "$FILE" -maxdepth 1 -type f -perm 0600 2>/dev/null || true)" ]; then
        printf '[%s] state file %s must have permissions 0600; ignoring blacklist\n' \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$FILE" >&5
        return 0
    fi
    local CONTENT VALUE
    CONTENT="$(cat "$FILE" 2>/dev/null)" || return 0
    VALUE="$(sed -n 's/^BLACKLIST_SIGNERS="\(.*\)"$/\1/p' <<< "$CONTENT" | tail -n1)"
    VALUE="$(tr '[:lower:]' '[:upper:]' <<< "$VALUE")"
    if [[ ! "$VALUE" =~ $BLACKLIST_VALUE_RE ]]; then
        printf '[%s] state file %s has an invalid blacklist value; ignoring blacklist\n' \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$FILE" >&5
        return 0
    fi
    BLACKLIST_SIGNERS="$VALUE"
    return 0
}

# Load the host version floor from the state file, or its locked variant.
# Unknown state lines are ignored: only the floor value is validated, so
# future state fields can't break the bootstrap. Missing files, bad
# permissions, or a malformed value contribute a floor of zero. The effective
# floor is the higher of the parcelrc and state-file values.
#
# @return 0 always; problems are logged, not reported.
# @since 1.0.8
function load_version_floor() {
    # deliberately lockless to keep the bootstrap simple: a mid-save read fails validation and fails open
    local FILE="$STATEFILE"
    if [ ! -e "$FILE" ] && [ -e "$STATEFILE.locked" ]; then
        FILE="$STATEFILE.locked"
    fi
    local STATE_VERSION="0"
    if [ -e "$FILE" ]; then
        if [ "$FILE" != "$(find "$FILE" -maxdepth 1 -type f -perm 0600 2>/dev/null || true)" ]; then
            printf '[%s] state file %s must have permissions 0600; ignoring version floor\n' \
                "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$FILE" >&5
        else
            local CONTENT VALUE
            CONTENT="$(cat "$FILE" 2>/dev/null)" || CONTENT=""
            VALUE="$(sed -n 's/^MINIMUM_HOST_VERSION="\(.*\)"$/\1/p' <<< "$CONTENT" | tail -n1)"
            if [ -n "$VALUE" ] && [[ ! "$VALUE" =~ ^[0-9]{1,9}$ ]]; then
                printf '[%s] state file %s has an invalid version floor; ignoring it\n' \
                    "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$FILE" >&5
                VALUE=""
            fi
            STATE_VERSION="${VALUE:-0}"
        fi
    fi
    if (( 10#$STATE_VERSION > 10#$MINIMUM_HOST_VERSION )); then
        MINIMUM_HOST_VERSION="$STATE_VERSION"
    fi
    return 0
}

# Check whether a fingerprint is on the effective revocation list.
#
# @param {string} fingerprint - The fingerprint to check.
# @return 0 if blacklisted, 1 otherwise.
# @since 1.0.7
function blacklisted() {
    [ -n "$1" ] || return 1
    local FPR TARGET
    TARGET="$(tr '[:lower:]' '[:upper:]' <<< "$1")"
    # deliberately unquoted: the lists are space-separated, and regex-validated as hex so glob expansion is impossible
    for FPR in $PARCELRC_BLACKLIST $BLACKLIST_SIGNERS; do
        if [ "$FPR" = "$TARGET" ]; then
            return 0
        fi
    done
    return 1
}

# bootstrap host script from extension
function action_install() {
    local SIGNATURE="$(jq -r '.signature' <<< "$1")"
    local SCRIPT="$(jq -r '.script' <<< "$1")"
    if [ "$SIGNATURE" == "null" ] || [ "$SCRIPT" == "null" ]; then
        parcel_error "$(jq -n '{action: "install-result", valid: false, message: "No signature or script was supplied"}')"
        return 0
    fi

    # verify signature
    local KEYRING
    if ! KEYRING="$(mktemp)"; then # gpg cannot process keys without an actual file, so we must use a temporary file for the keyring in order to avoid polluting the user's own
        parcel_error "Unable to create temporary file for keyring"
        return 0
    fi
    local OUT
    # GNUPGHOME=/dev/null prevents keyboxd (GnuPG 2.4+) from intercepting --keyring:
    # GPG tries to read /dev/null/common.conf, which fails (ENOTDIR), so use-keyboxd
    # is never set and --keyring is respected. --no-autostart prevents gpg-agent
    # from trying to create lock files in /dev/null/ (ENOTDIR), which would cause
    # a non-zero exit despite valid verification. --no-options skips gpg.conf.
    # Note that a use-keyboxd setting in the system-wide common.conf (sysconfdir)
    # would still apply, as it is read independently of the homedir.
    # See issue #107.
    if ! OUT="$(GNUPGHOME=/dev/null gpg --no-options --no-autostart --status-fd=1 --quiet --verify --trust-model always --auto-key-import --no-default-keyring --keyring "$KEYRING" <(echo "$SIGNATURE") <(echo "$SCRIPT") 2>&1)"; then
        # Log the full GPG output for debugging; do not leak it to the extension.
        printf '[%s] Signature verification failed: GPG error:\n%s\n' \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$OUT" >&5
        rm -f "$KEYRING" "$KEYRING"~
        parcel_error "Signature verification failed"
        return 0
    fi
    rm -f "$KEYRING" "$KEYRING"~

    # verify signer: accept the first signature from a trusted, non-revoked
    # key. Field 12 is the primary fingerprint (whitelist); field 3 is the
    # signing key, which may be a subkey. The blacklist matches either.
    local LINE
    local SIGNER
    local SIGNING_KEY
    local SIGNER_VALID=false
    while IFS= read -r LINE; do
        SIGNER="$(cut -d' ' -f12 <<< "$LINE")"
        SIGNING_KEY="$(cut -d' ' -f3 <<< "$LINE")"
        # non-hex values can never exactly match a well-formed list
        [[ "$SIGNER" =~ $FPR_RE ]] || SIGNER=""
        [[ "$SIGNING_KEY" =~ $FPR_RE ]] || SIGNING_KEY=""
        if [ -n "$SIGNER" ] && [[ " $VALID_SIGNERS " =~ [[:space:]]${SIGNER}[[:space:]] ]]; then
            if blacklisted "$SIGNER" || blacklisted "$SIGNING_KEY"; then
                # Log the revocation; do not leak it to the extension.
                printf '[%s] Signature verification failed: signer %s (signing key %s) is blacklisted\n' \
                    "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$SIGNER" "${SIGNING_KEY:-unknown}" >&5
                continue
            fi
            SIGNER_VALID=true
            break
        fi
    done < <(grep '^\[GNUPG:\] VALIDSIG ' <<< "$OUT")
    if ! $SIGNER_VALID; then
        # Log the full GPG status output for debugging; do not leak it to the extension.
        printf '[%s] Signature verification failed: No valid signer fingerprint:\n%s\n' \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$OUT" >&5
        parcel_error "Signature verification failed: No valid signer fingerprint"
        return 0
    fi

    # verify hash
    if [ -n "$HOST_HASH" ]; then
        if [ -z "$SHA256" ]; then
            parcel_error "Cannot verify host script hash: no sha256 utility (sha256sum or sha256) found in PATH"
            return 1
        fi
        HASH=$(jq -rj '.script' <<< "$1" | "$SHA256" | awk '{print $1}')
        if [ "$HASH" != "$HOST_HASH" ]; then
            parcel_error "Unapproved host script hash - please review the updated host script, then set the new hash $HASH in your parcelrc file and reload the browser extension."
            return 1
        fi
    fi

    # version ratchet: refuse candidates below the effective minimum version
    local CANDIDATE_VERSION
    CANDIDATE_VERSION="$(sed -n 's/^HOST_VERSION="\([0-9][0-9]*\)"$/\1/p' <<< "$SCRIPT" | head -n1)"
    if [[ ! "$CANDIDATE_VERSION" =~ ^[0-9]{1,9}$ ]]; then
        # a script without a usable version marker predates the ratchet and earns no floor credit
        CANDIDATE_VERSION="0"
    fi
    if (( 10#$CANDIDATE_VERSION < 10#$MINIMUM_HOST_VERSION )); then
        printf '[%s] Refusing to install host script version %s: the minimum permitted version is %s\n' \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$CANDIDATE_VERSION" "$MINIMUM_HOST_VERSION" >&5
        parcel_error "Refusing to install outdated host script"
        return 0
    fi

    PARCEL_HOST="$SCRIPT"

    parcel_send '{"success": true, "message": "Native host script installed successfully"}'
}

# main event loop
function main() {
    while MSG_LEN="$(printf %ld "0x$(dd bs=4 count=1 2> /dev/null | od -An -tx4 | tr -d '[:space:]')" 2>/dev/null)"; do
        if [ "$MSG_LEN" -gt 16777216 ]; then
            parcel_error "Message is too large (max 16MiB): $MSG_LEN bytes"
            exit 1
        fi
        local MESSAGE="$(head -c "$MSG_LEN")"
        local NEW_TOKEN="$(jq -r .token <<< "$MESSAGE")"
        if [ -n "$NEW_TOKEN" ] && [ "$NEW_TOKEN" != "null" ]; then
            TOKEN="$NEW_TOKEN"
        fi
        local ACTION="$(jq -r .action <<< "$MESSAGE")"
        if [ -z "$ACTION" ]; then
            parcel_error "Missing host action"
        elif [[ ! "$ACTION" =~ ^[a-zA-Z0-9_]+$ ]]; then
            parcel_error "Invalid host action: $ACTION"
        else
            if [ "$(type -t "action_$ACTION")" = "function" ]; then
                if ! "action_$ACTION" "$MESSAGE"; then
                    parcel_error "Unknown error for action '$ACTION' - please check the parcel-host log"
                fi
                if [ "$ACTION" = "install" ]; then
                    return 2 # exit the loop after installing the main host script
                fi
            else
                parcel_error "Unknown host action: $ACTION"
            fi
        fi
    done
}

# ensure jq works
if ! command -v jq &> /dev/null; then
    parcel_transmit '{"token": "broadcast", "error": "Cannot find jq ('"${JQ:-jq}"'): Please configure the correct path for it in parcelrc"}'
    exit 1
fi
if ! jq --version &> /dev/null; then
    parcel_transmit '{"token": "broadcast", "error": "jq is not executable: '"${JQ:-jq}"'"}'
    exit 1
fi

# ensure gpg works
if ! command -v gpg &> /dev/null; then
    parcel_error "Cannot find gpg (${GPG:-gpg}): Please configure the correct path for it in parcelrc" 1
fi
if ! GNUPGHOME=/dev/null gpg --version &> /dev/null; then
    parcel_error "gpg is not executable: ${GPG:-gpg}" 1
fi

# load the persisted signer revocation list before the event loop
load_blacklist

# load the persisted host version floor before the event loop
load_version_floor

# tell the extension that we are ready for bootstrapping
parcel_send "$(jq -n --arg version "$BOOTSTRAP_VERSION" '{action: "bootstrap", version: $version}')"

# run main event loop
while true; do
    # Load new host script if it exists
    if [ -n "$PARCEL_HOST" ]; then
        eval "$PARCEL_HOST"
        PARCEL_HOST=""
    fi
    # Restart the main loop
    rc=0
    main || rc=$?
    if [ $rc -eq 0 ]; then
        break # clean exit
    elif [ $rc -eq 2 ]; then
        continue # explicit reload
    else
        exit $rc # exit with error code
    fi
done
