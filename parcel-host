TOKEN="broadcast"
PARCEL_HOST=""
BOOTSTRAP_VERSION="3"

# transmit message in native messaging host protocol
function parcel_transmit() {
    local LC_ALL=C
    local s=$1 n=${#1} b
    printf -v b '\\x%02x\\x%02x\\x%02x\\x%02x' \
        "$(( n       & 255 ))" \
        "$(( n >> 8  & 255 ))" \
        "$(( n >> 16 & 255 ))" \
        "$(( n >> 24 & 255 ))"
    printf '%b%s' "$b" "$s"
}

# resolve the config directory, respecting $XDG_CONFIG_HOME per the XDG Base
# Directory Specification (falls back to $HOME/.config when unset, empty, or
# not an absolute path, as the spec requires all such paths to be absolute)
if [[ "${XDG_CONFIG_HOME:-}" == /* ]]; then
    CONFIG_DIR="$XDG_CONFIG_HOME/parcel"
else
    CONFIG_DIR="$HOME/.config/parcel"
fi

# create default startup config file if it doesn't exist
PARCELRC="$CONFIG_DIR/parcelrc"
if [ ! -e "$PARCELRC" ]; then
    mkdir -p "$(dirname "$PARCELRC")"
    cat > "$PARCELRC" <<EOT
# This file was automatically generated by the parcel-host bootstrap script

# Valid signers for the main host script which is bundled with the extension (space-separated)
#VALID_SIGNERS="88FF14D6294AF4036B7F00FF676A3C09E2E47A72 56C3E775E72B0C8B1C0C1BD0B5DB77409B11B601 82ED663067C6017BAA4BC752EB670BF2B1131683 B0908ED59A96C9882BED9A942A51761511A30253"

# Signers to revoke even if valid (space-separated, primary or subkey fingerprint)
#BLACKLIST_SIGNERS=""

# If you use MacOS, you may wish to include homebrew's bin directory in parcel's PATH
#PATH="\$PATH:/opt/homebrew/bin"

# The gpg binary to use.
# Default: gpg
#GPG="gpg"

# The jq binary to use.
# Default: jq
#JQ="jq"

# The openssl binary to use.
# Default: openssl
#OPENSSL="openssl"

# Where to write the log file
#LOGFILE="\$HOME/.local/log/parcel-host.log"

# Where to persist non-sensitive runtime state (e.g. rate-limiter bucket state)
#STATEFILE="\$HOME/.config/parcel/state"

# The password store directory
#PASSWORD_STORE_DIR="\$HOME/.password-store"

# The sha256 hash of the main host script which is bundled with the extension.
# This is used to verify the integrity of the script before executing it. By
# default, this is not set, but if you wish to review any updates to the host
# script before they are executed, you can set this to the expected hash and the
# bootstrap script will verify the hash of the script before executing it.
#HOST_HASH="1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"
EOT
chmod 0600 "$PARCELRC"
fi

# check that parcelrc has the correct permissions
if [ "$PARCELRC" != "$(find "$PARCELRC" -maxdepth 1 -type f -perm 0600 2>/dev/null || true)" ]; then
    parcel_transmit '{"token": "broadcast", "error": "parcelrc file must have permissions 0600"}'
    exit 1
fi

# load startup config & set up dedicated logging
LOGFILE="$HOME/.local/log/parcel-host.log"
# shellcheck disable=SC2034 # consumed by the evaluated main host script
PASSWORD_STORE_DIR="$HOME/.password-store"
. "$PARCELRC"
mkdir -p "$(dirname "$LOGFILE")"
exec 5>>"$LOGFILE"
exec 2>&5
chmod 0600 "$LOGFILE"
if [ -z "$VALID_SIGNERS" ]; then VALID_SIGNERS="88FF14D6294AF4036B7F00FF676A3C09E2E47A72 56C3E775E72B0C8B1C0C1BD0B5DB77409B11B601 82ED663067C6017BAA4BC752EB670BF2B1131683 B0908ED59A96C9882BED9A942A51761511A30253"; fi

# GPG emits uppercase fingerprints; normalise config lists so comparisons match exactly
VALID_SIGNERS="$(tr '[:lower:]' '[:upper:]' <<< "$VALID_SIGNERS")"

# resolve the state file (also overridable via parcelrc)
STATEFILE="${STATEFILE:-$CONFIG_DIR/state}"

# a signer fingerprint is exactly 40 or 64 hex characters
FPR_PATTERN='[0-9A-Fa-f]{40}([0-9A-Fa-f]{24})?'
FPR_RE="^${FPR_PATTERN}$"
# a well-formed blacklist value: empty or space-separated fingerprints
BLACKLIST_VALUE_RE="^(${FPR_PATTERN}( ${FPR_PATTERN})*)?$"

# capture the parcelrc blacklist separately so the state-file list can be
# combined with it rather than clobbered
PARCELRC_BLACKLIST="$(tr '[:lower:]' '[:upper:]' <<< "${BLACKLIST_SIGNERS:-}")"
if [[ ! "$PARCELRC_BLACKLIST" =~ $BLACKLIST_VALUE_RE ]]; then
    printf '[%s] parcelrc BLACKLIST_SIGNERS is malformed; ignoring it\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" >&5
    PARCELRC_BLACKLIST=""
fi

# effective revocation list (state-file value, then the shipped list)
BLACKLIST_SIGNERS=""

if [ -n "$GPG" ]; then function gpg() { "$GPG" "$@"; return $?; }; fi
if [ -n "$JQ" ]; then function jq() { "$JQ" "$@"; return $?; }; fi

# Ensure we have a usable sha256
SHA256="$(command -v sha256sum || command -v sha256)"


# sender for errors
# $1: error message
# $2: optional exit code
function parcel_error() {
    if [ ${#1} -gt 0 ]; then
        parcel_transmit "$(jq -n --arg token "$TOKEN" --arg msg "$1" '{token: $token, error: $msg}')"
    fi
    if [ -n "$2" ]; then
        exit "$2"
    fi
}

# sender for regular messages
# $1: message (JSON object)
function parcel_send() {
    if [ ${#1} -gt 0 ]; then
        parcel_transmit "$(jq --arg token "$TOKEN" '{token: $token, data: .}' <<< "$1")"
    fi
}

# Load the signer blacklist from the state file, or its locked variant.
# Unknown state lines are ignored: only the blacklist value is validated, so
# future state fields can't break the bootstrap. Missing files, bad
# permissions, or a malformed value leave the blacklist empty. The value
# stands only until the next install; durable revocations belong in parcelrc.
#
# @return 0 always; problems are logged, not reported.
# @since 1.0.7
function load_blacklist() {
    # deliberately lockless to keep the bootstrap simple: a mid-save read fails validation and fails open
    local FILE="$STATEFILE"
    if [ ! -e "$FILE" ] && [ -e "$STATEFILE.locked" ]; then
        FILE="$STATEFILE.locked"
    fi
    [ -e "$FILE" ] || return 0
    if [ "$FILE" != "$(find "$FILE" -maxdepth 1 -type f -perm 0600 2>/dev/null || true)" ]; then
        printf '[%s] state file %s must have permissions 0600; ignoring blacklist\n' \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$FILE" >&5
        return 0
    fi
    local CONTENT VALUE
    CONTENT="$(cat "$FILE" 2>/dev/null)" || return 0
    VALUE="$(sed -n 's/^BLACKLIST_SIGNERS="\(.*\)"$/\1/p' <<< "$CONTENT" | tail -n1)"
    VALUE="$(tr '[:lower:]' '[:upper:]' <<< "$VALUE")"
    if [[ ! "$VALUE" =~ $BLACKLIST_VALUE_RE ]]; then
        printf '[%s] state file %s has an invalid blacklist value; ignoring blacklist\n' \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$FILE" >&5
        return 0
    fi
    BLACKLIST_SIGNERS="$VALUE"
    return 0
}

# Check whether a fingerprint is on the effective revocation list.
#
# @param {string} fingerprint - The fingerprint to check.
# @return 0 if blacklisted, 1 otherwise.
# @since 1.0.7
function blacklisted() {
    [ -n "$1" ] || return 1
    local FPR TARGET
    TARGET="$(tr '[:lower:]' '[:upper:]' <<< "$1")"
    # deliberately unquoted: the lists are space-separated, and regex-validated as hex so glob expansion is impossible
    for FPR in $PARCELRC_BLACKLIST $BLACKLIST_SIGNERS; do
        if [ "$FPR" = "$TARGET" ]; then
            return 0
        fi
    done
    return 1
}

# bootstrap host script from extension
function action_install() {
    local SIGNATURE="$(jq -r '.signature' <<< "$1")"
    local SCRIPT="$(jq -r '.script' <<< "$1")"
    if [ "$SIGNATURE" == "null" ] || [ "$SCRIPT" == "null" ]; then
        parcel_error "$(jq -n '{action: "install-result", valid: false, message: "No signature or script was supplied"}')"
        return 0
    fi

    # verify signature
    local KEYRING
    if ! KEYRING="$(mktemp)"; then # gpg cannot process keys without an actual file, so we must use a temporary file for the keyring in order to avoid polluting the user's own
        parcel_error "Unable to create temporary file for keyring"
        return 0
    fi
    local OUT
    # GNUPGHOME=/dev/null prevents keyboxd (GnuPG 2.4+) from intercepting --keyring:
    # GPG tries to read /dev/null/common.conf, which fails (ENOTDIR), so use-keyboxd
    # is never set and --keyring is respected. --no-autostart prevents gpg-agent
    # from trying to create lock files in /dev/null/ (ENOTDIR), which would cause
    # a non-zero exit despite valid verification. --no-options skips gpg.conf.
    # Note that a use-keyboxd setting in the system-wide common.conf (sysconfdir)
    # would still apply, as it is read independently of the homedir.
    # See issue #107.
    if ! OUT="$(GNUPGHOME=/dev/null gpg --no-options --no-autostart --status-fd=1 --quiet --verify --trust-model always --auto-key-import --no-default-keyring --keyring "$KEYRING" <(echo "$SIGNATURE") <(echo "$SCRIPT") 2>&1)"; then
        # Log the full GPG output for debugging; do not leak it to the extension.
        printf '[%s] Signature verification failed: GPG error:\n%s\n' \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$OUT" >&5
        rm -f "$KEYRING" "$KEYRING"~
        parcel_error "Signature verification failed"
        return 0
    fi
    rm -f "$KEYRING" "$KEYRING"~

    # verify signer: accept the first signature from a trusted, non-revoked
    # key. Field 12 is the primary fingerprint (whitelist); field 3 is the
    # signing key, which may be a subkey. The blacklist matches either.
    local LINE
    local SIGNER
    local SIGNING_KEY
    local SIGNER_VALID=false
    while IFS= read -r LINE; do
        SIGNER="$(cut -d' ' -f12 <<< "$LINE")"
        SIGNING_KEY="$(cut -d' ' -f3 <<< "$LINE")"
        # non-hex values can never exactly match a well-formed list
        [[ "$SIGNER" =~ $FPR_RE ]] || SIGNER=""
        [[ "$SIGNING_KEY" =~ $FPR_RE ]] || SIGNING_KEY=""
        if [ -n "$SIGNER" ] && [[ " $VALID_SIGNERS " =~ [[:space:]]${SIGNER}[[:space:]] ]]; then
            if blacklisted "$SIGNER" || blacklisted "$SIGNING_KEY"; then
                # Log the revocation; do not leak it to the extension.
                printf '[%s] Signature verification failed: signer %s (signing key %s) is blacklisted\n' \
                    "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$SIGNER" "${SIGNING_KEY:-unknown}" >&5
                continue
            fi
            SIGNER_VALID=true
            break
        fi
    done < <(grep '^\[GNUPG:\] VALIDSIG ' <<< "$OUT")
    if ! $SIGNER_VALID; then
        # Log the full GPG status output for debugging; do not leak it to the extension.
        printf '[%s] Signature verification failed: No valid signer fingerprint:\n%s\n' \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$OUT" >&5
        parcel_error "Signature verification failed: No valid signer fingerprint"
        return 0
    fi

    # verify hash
    if [ -n "$HOST_HASH" ]; then
        HASH=$(jq -rj '.script' <<< "$1" | "$SHA256" | awk '{print $1}')
        if [ "$HASH" != "$HOST_HASH" ]; then
            parcel_error "Unapproved host script hash - please review the updated host script, then set the new hash $HASH in your parcelrc file and reload the browser extension."
            return 1
        fi
    fi

    PARCEL_HOST="$SCRIPT"

    parcel_send '{"success": true, "message": "Native host script installed successfully"}'
}

# main event loop
function main() {
    while MSG_LEN="$(printf %ld "0x$(dd bs=4 count=1 2> /dev/null | od -An -tx4 | tr -d '[:space:]')" 2>/dev/null)"; do
        if [ "$MSG_LEN" -gt 16777216 ]; then
            parcel_error "Message is too large (max 16MiB): $MSG_LEN bytes"
            exit 1
        fi
        local MESSAGE="$(head -c "$MSG_LEN")"
        local NEW_TOKEN="$(jq -r .token <<< "$MESSAGE")"
        if [ -n "$NEW_TOKEN" ] && [ "$NEW_TOKEN" != "null" ]; then
            TOKEN="$NEW_TOKEN"
        fi
        local ACTION="$(jq -r .action <<< "$MESSAGE")"
        if [ -z "$ACTION" ]; then
            parcel_error "Missing host action"
        elif [[ ! "$ACTION" =~ ^[a-zA-Z0-9_]+$ ]]; then
            parcel_error "Invalid host action: $ACTION"
        else
            if [ "$(type -t "action_$ACTION")" = "function" ]; then
                if ! "action_$ACTION" "$MESSAGE"; then
                    parcel_error "Unknown error for action '$ACTION' - please check the parcel-host log"
                fi
                if [ "$ACTION" = "install" ]; then
                    return 2 # exit the loop after installing the main host script
                fi
            else
                parcel_error "Unknown host action: $ACTION"
            fi
        fi
    done
}

# ensure jq works
if ! command -v jq &> /dev/null; then
    parcel_transmit '{"token": "broadcast", "error": "Cannot find jq ('"${JQ:-jq}"'): Please configure the correct path for it in parcelrc"}'
    exit 1
fi
if ! jq --version &> /dev/null; then
    parcel_transmit '{"token": "broadcast", "error": "jq is not executable: '"${JQ:-jq}"'"}'
    exit 1
fi

# ensure gpg works
if ! command -v gpg &> /dev/null; then
    parcel_error "Cannot find gpg (${GPG:-gpg}): Please configure the correct path for it in parcelrc" 1
fi
if ! GNUPGHOME=/dev/null gpg --version &> /dev/null; then
    parcel_error "gpg is not executable: ${GPG:-gpg}" 1
fi

# load the persisted signer revocation list before the event loop
load_blacklist

# tell the extension that we are ready for bootstrapping
parcel_send "$(jq -n --arg version "$BOOTSTRAP_VERSION" '{action: "bootstrap", version: $version}')"

# run main event loop
while true; do
    # Load new host script if it exists
    if [ -n "$PARCEL_HOST" ]; then
        eval "$PARCEL_HOST"
        PARCEL_HOST=""
    fi
    # Restart the main loop
    rc=0
    main || rc=$?
    if [ $rc -eq 0 ]; then
        break # clean exit
    elif [ $rc -eq 2 ]; then
        continue # explicit reload
    else
        exit $rc # exit with error code
    fi
done
