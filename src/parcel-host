# set up the environment
TOKEN="broadcast"
ALLOWED_FILES=()
PASSKEY_FILES=()
if [ ! -d "$PASSWORD_STORE_DIR" ]; then
    parcel_error "Invalid password store directory: $PASSWORD_STORE_DIR" 1
fi

# allow the user to override the openssl binary via parcelrc
if [ -n "$OPENSSL" ]; then function openssl() { "$OPENSSL" "$@"; return $?; }; fi

# token-bucket rate limiter for action_decrypt
DECRYPT_BUCKET_TOKENS=""
DECRYPT_BUCKET_LAST=""
DECRYPT_BUCKET_SIZE_DEFAULT=24 # default also set in schema.js
DECRYPT_BUCKET_RATE_DEFAULT=0.006667 # default also set in schema.js
PARCELFILE="$PASSWORD_STORE_DIR/.parcel.json"
CONFIG="{}"
CONFIG_MODIFIED=-1
REPORT_MODIFIED=0

# dedicated state file for persisting non-sensitive runtime state between host invocations
STATEFILE="${STATEFILE:-$HOME/.config/parcel/state}"

function get_mtime() {
    stat -L -c %Y "$1" 2>/dev/null || stat -L -f %m "$1"
}

# get a millisecond timestamp with MacOS fallback to whole seconds
function get_timestamp_ms() {
    local TS
    TS="$(date +%s%3N 2>/dev/null)"
    if [[ "$TS" =~ ^[0-9]{13}$ ]]; then
        echo "$TS"
    else
        date +%s000
    fi
}

# load persisted state; sourced directly, so require 0600 as per parcelrc. Bad permissions or
# corrupt values reset the bucket to defaults — a deliberate fail-open for robustness.
function load_state() {
    mkdir -p "$(dirname "$STATEFILE")"
    if [ ! -f "$STATEFILE" ]; then
        touch "$STATEFILE"
        chmod 0600 "$STATEFILE"
        return 0
    fi
    if [ "$STATEFILE" != "$(find "$STATEFILE" -maxdepth 1 -type f -perm 0600 2>/dev/null || true)" ]; then
        printf '[%s] state file %s must have permissions 0600; refusing to load state\n' \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$STATEFILE" >&5
        return 0
    fi
    . "$STATEFILE" 2>/dev/null
    # discard loaded values if they are non-numeric
    if [[ ! "$DECRYPT_BUCKET_TOKENS" =~ ^[0-9]+$ ]]; then
        DECRYPT_BUCKET_TOKENS=""
    fi
    if [[ ! "$DECRYPT_BUCKET_LAST" =~ ^[0-9]+$ ]]; then
        DECRYPT_BUCKET_LAST=""
    fi
}

# save current state variables to the state file (clobbers).
# only non-sensitive numeric values are written.
function save_state() {
    printf 'DECRYPT_BUCKET_TOKENS=%s\nDECRYPT_BUCKET_LAST=%s\n' \
        "$DECRYPT_BUCKET_TOKENS" "$DECRYPT_BUCKET_LAST" > "$STATEFILE"
    chmod 0600 "$STATEFILE"
}

# load the configuration
function load_config() {
    if [ -f "$PARCELFILE" ]; then
        if ! CONFIG="$(cat "$PARCELFILE")"; then
            parcel_error "Failed to read config file: $PARCELFILE" 1
        fi
        CONFIG_MODIFIED="$(get_mtime "$PARCELFILE")"
    else
        CONFIG="{}"
        CONFIG_MODIFIED=0
    fi
    # Ensure the JSON modified field is always strictly increasing so the
    # extension's `>` comparison detects every change (file modification,
    # deletion, and re-creation with an older mtime). When the file's mtime
    # is not greater than the last value we sent, increment by one instead.
    if [ "$CONFIG_MODIFIED" -le "$REPORT_MODIFIED" ]; then
        REPORT_MODIFIED=$((REPORT_MODIFIED + 1))
    else
        REPORT_MODIFIED="$CONFIG_MODIFIED"
    fi
    local REALPASSDIR="$(readlink -f "$PASSWORD_STORE_DIR")"
    if ! CONFIG="$(jq --arg passdir "$PASSWORD_STORE_DIR" --arg realPassdir "$REALPASSDIR" --arg mtime "$REPORT_MODIFIED" '
        def reescape: reduce (explode[]) as $c (""; if ([36,40,41,42,43,46,47,63,91,92,93,94,123,124,125] | index($c)) != null then . + "\\" + ([$c] | implode) else . + ([$c] | implode) end);
        def defrules: [{pattern: ("^" + ((."passkeyDir" // "passkeys") | reescape) + "/"), class: "passkey"}, {pattern: "."}];
        . + {modified: ($mtime|tonumber)} + {passdir: $passdir} + {realPassdir: $realPassdir} + (if has("rules") then null else {rules: defrules, defaultRules: true} end)' <<< "$CONFIG")"; then
        parcel_error "Failed to parse config file: $PARCELFILE" 1
    fi
}

# ensure that the config is up to date
function update_config() {
    local CURRENT_MODIFIED
    if [ -f "$PARCELFILE" ]; then
        CURRENT_MODIFIED="$(get_mtime "$PARCELFILE")"
    else
        CURRENT_MODIFIED=0
    fi
    if [ "$CONFIG_MODIFIED" -ne "$CURRENT_MODIFIED" ]; then
        load_config
        action_list >/dev/null
    fi
}

# collect a list of scan roots that comply with the configured symlink settings
collect_roots() {
    local REAL_PASSDIR="$(readlink -f "$1")"
    local ROOTS=("$1")
    local ROOT_IDX=0
    local ALLOW_LINKS="$2"
    local ALLOW_EXTERNAL_LINKS="$3"

    if [ "$ALLOW_LINKS" != "true" ]; then
        if [ -L "$1" ]; then
            # check allowLinks, but not allowExternalLinks, as the password store *root* being a link is not considered external
            parcel_error "PASSWORD_STORE_DIR is a symlink, but allowLinks is not enabled." 1
        fi
        printf '%s\n' "${ROOTS[@]}"
        return 0
    fi

    while [ $ROOT_IDX -lt ${#ROOTS[@]} ]; do
        local CURRENT="${ROOTS[$ROOT_IDX]}"
        while IFS= read -r LINK; do
            if [ -z "$LINK" ]; then
                continue
            fi
            local TARGET
            if ! TARGET="$(readlink -f "$LINK" 2>/dev/null)"; then
                continue
            fi
            if [ "$ALLOW_EXTERNAL_LINKS" == "true" ] || [[ "$TARGET" == "$REAL_PASSDIR"/* ]]; then
                if [ ! -d "$TARGET" ]; then
                    continue
                fi
                local ALREADY_INCLUDED=0
                for ROOT in "${ROOTS[@]}"; do
                    if [ "$ROOT" == "$LINK" ]; then
                        ALREADY_INCLUDED=1
                        break
                    fi
                done
                if [ $ALREADY_INCLUDED -eq 0 ]; then
                    ROOTS+=("$LINK") # save the non-dereferenced path, as the user may want the same entry accessible via multiple links
                fi
            fi
        done < <(find -H -- "$CURRENT"/ \( -name '.git' -prune \) -o \( -type l -not -path "$CURRENT/.*" -not -path "$CURRENT/**/.*" -print \))
        ROOT_IDX=$((ROOT_IDX + 1))
    done

    # return the list
    printf '%s\n' "${ROOTS[@]}"
}

# get the current config
function action_configure() {
    update_config
    parcel_send "$CONFIG"
}

# check whether there have been any changes to the password store since the last time the list was generated
function action_changes_since() {
    update_config
    local SINCE="$(jq -r '.since' <<< "$1")"
    if [[ -z "$SINCE" || "$SINCE" == "null" || ! "$SINCE" =~ ^[0-9]{10}$ ]]; then
        parcel_error "Invalid timestamp: $SINCE"
    fi
    SINCE="$(date -d "@$SINCE" +'%Y-%m-%d %H:%M:%S' 2>/dev/null || date -j -f "%s" "$SINCE" +'%Y-%m-%d %H:%M:%S')"

    local ROOTS=()
    while IFS= read -r ROOT; do
        ROOTS+=("$ROOT")
    done < <(collect_roots "$PASSWORD_STORE_DIR" "$(jq -r '.allowLinks' <<< "$CONFIG")" "$(jq -r '.allowExternalLinks' <<< "$CONFIG")")

    local EXCLUDE=()
    for ROOT in "${ROOTS[@]}"; do
        EXCLUDE+=( -not -path "${ROOT}/.*" -not -path "${ROOT}/**/.*" )
    done

    if find -H -- "${ROOTS[@]}" \( -type d -name '.git' -prune \) -o \( -type d "${EXCLUDE[@]}" -newermt "$SINCE" -print \) | read -r _; then
        # we don't care about the actual number of changed directories, just whether there are any
        parcel_send '{"changes": 1}'
        return 0
    fi

    parcel_send '{"changes": 0}'
}

# get a list of all the password entries which match the config
function action_list() {
    update_config

    local ALLOW_LINKS="$(jq -r '.allowLinks' <<< "$CONFIG")"
    local ALLOW_EXTERNAL_LINKS="$(jq -r '.allowExternalLinks' <<< "$CONFIG")"

    local ROOTS=()
    while IFS= read -r ROOT; do
        ROOTS+=("$ROOT")
    done < <(collect_roots "$PASSWORD_STORE_DIR" "$ALLOW_LINKS" "$ALLOW_EXTERNAL_LINKS")

    local MIXED=""
    for ROOT in "${ROOTS[@]}"; do
        MIXED+="$(
            find -H -- "$ROOT"/ \( -type d -name '.git' -prune \) -o \( \( -type f -o -type l \) -not -path "${ROOT}/.*" -not -path "${ROOT}/**/.*" -name '*.gpg' -print \) 2>&1 || true
        )"$'\n'
    done

    local FIND_OUT=""
    local FIND_ERR=""
    while true; do
        IFS= read -r line || break
        if [[ "$line" == "find:"* ]]; then
            FIND_ERR+="$line"$'\n'
        elif [ -n "$line" ]; then
            FIND_OUT+="$line"$'\n'
        fi
    done <<< "$MIXED"
    if [ -n "$FIND_ERR" ]; then
        parcel_error "Unable to scan files: $FIND_ERR"
        return 0
    fi

    local REAL_OUT="$(printf '%s' "$FIND_OUT" | tr '\n' '\0' | xargs -0 -n100 readlink -f || true)"

    local SYMLINKS=()
    while IFS= read -r link; do
        if [ -n "$link" ]; then
            SYMLINKS+=("$link/")
        fi
    done < <(find "$PASSWORD_STORE_DIR" -not -path "$PASSWORD_STORE_DIR/.*" -not -path "$PASSWORD_STORE_DIR/**/.*" -type l -print)
    local IS_LINK=""
    while IFS= read -r line; do
        if [ -n "$line" ]; then
            local linked=0
            if test -L "$line"; then
                linked=1
            else
                for prefix in "${SYMLINKS[@]}"; do
                    if [[ "$line" == "$prefix"* ]]; then
                        linked=1
                        break
                    fi
                done
            fi
            IS_LINK+="$linked"$'\n'
        fi
    done <<< "$FIND_OUT"
    local OUT="$(
            jq -n --rawfile path <(echo "$FIND_OUT") --rawfile real <(echo "$REAL_OUT") --rawfile is_link <(echo "$IS_LINK") '
                [$path, $real, $is_link]
                | map(rtrimstr("\n") | split("\n") | map(select(length > 0)))
                | transpose
                | map({path: .[0], real: .[1], is_link: (.[2] | tonumber)})
                | {entries: .}
                ' |
            jq -s '
                .[0] * .[1]
                | . as $top
                # browser-passkey rules are site policy matched against relying-party
                # IDs, not entry names - exclude them from entry-matching derivations
                | ($top.rules|map(select(.class != "browser-passkey"))) as $erules
                | ($erules|map(select(.ignore==false or (has("ignore") | not)).pattern)) as $include
                | ($erules|map(select(.ignore==true).pattern)) as $ignore
                | ($erules|map(select(.class=="passkey").pattern)) as $passkey
                | .entries | (
                    map(
                        .={path: .path, name: .path | ltrimstr($top.passdir + "/") | rtrimstr(".gpg"), is_link: (.is_link == 1), real: .real}
                        | . as $entry
                        | .is_passkey = (reduce $passkey[] as $pattern (false; . or ($entry.name|test($pattern))))
                        | select(
                            reduce $include[] as $pattern (false; . or ($entry.name|test($pattern)))
                            and (reduce $ignore[] as $pattern (false; . or ($entry.name|test($pattern)))|not)
                            and (
                                ($entry.is_link | not)
                                or (
                                    ($top.allowLinks == true) and (
                                        ($entry.real | startswith($top.realPassdir + "/"))
                                        or (($entry.real | startswith($top.realPassdir + "/") | not) and $top.allowExternalLinks == true)
                                    )
                                )
                            )
                        )
                    )
                    | sort_by(.name)

                )
            ' \
                <(echo "$CONFIG") -
    )"

    # kludgery required to set a global array's content using a string of single-quoted strings
    declare -a LOCAL_AF="( $(jq -rc 'map(.path) | @sh' <<< "$OUT") )"
    ALLOWED_FILES=( "${LOCAL_AF[@]}" )

    declare -a LOCAL_PKF="( $(jq -rc 'map(select(.is_passkey)) | map(.path) | @sh' <<< "$OUT") )"
    PASSKEY_FILES=( "${LOCAL_PKF[@]}" )

    parcel_send "$OUT"
}

# audit a decryption attempt
function audit_decrypt() {
    local SHOULD_AUDIT="$(jq -r '.auditDecrypt' <<< "$CONFIG")"
    if [ "$SHOULD_AUDIT" != "true" ]; then
        return 0
    fi
    local FILE_PATH="${1//[[:cntrl:]]/}"
    local TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    local MESSAGE="${2//[[:cntrl:]]/}"
    local INTENT="${3//[[:cntrl:]]/}"
    local ORIGIN="${4//[[:cntrl:]]/}"
    echo "[$TIMESTAMP] DECRYPT ${INTENT:0:128} ${ORIGIN:0:1024} ${FILE_PATH:0:1024}: ${MESSAGE:0:4096}" >&5
}

# check the token-bucket rate limiter for action_decrypt
function check_decrypt_rate_limit() {
    local BUCKET_SIZE="$(jq -r '.decryptBucket' <<< "$CONFIG")"
    local RATE="$(jq -r '.decryptRate' <<< "$CONFIG")"
    if [ "$BUCKET_SIZE" == "null" ]; then
        BUCKET_SIZE=$DECRYPT_BUCKET_SIZE_DEFAULT
    fi
    if [ "$RATE" == "null" ]; then
        RATE=$DECRYPT_BUCKET_RATE_DEFAULT
    fi
    # rate limiting disabled when bucket or rate is zero
    if [ "$BUCKET_SIZE" -eq 0 ] || awk -v rate="$RATE" 'BEGIN { exit !(rate == 0) }'; then
        return 0
    fi

    # load persisted state before computing (best-effort only — load/compute/save is deliberately not atomic)
    load_state

    local NOW
    NOW="$(get_timestamp_ms)"

    local BUCKET_MILLIS=$((BUCKET_SIZE * 1000))

    if [ -z "$DECRYPT_BUCKET_TOKENS" ] && [ -z "$DECRYPT_BUCKET_LAST" ]; then
        DECRYPT_BUCKET_TOKENS="$BUCKET_MILLIS"
        DECRYPT_BUCKET_LAST="$NOW"
    fi

    local ELAPSED_MS=$((NOW - DECRYPT_BUCKET_LAST))
    local REFILL
    REFILL=$(printf '%s\n' "$ELAPSED_MS $RATE" | awk '{ printf "%.0f", $1 * $2 }')

    DECRYPT_BUCKET_TOKENS=$((DECRYPT_BUCKET_TOKENS + REFILL))
    if [ "$DECRYPT_BUCKET_TOKENS" -gt "$BUCKET_MILLIS" ]; then
        DECRYPT_BUCKET_TOKENS="$BUCKET_MILLIS"
    fi
    DECRYPT_BUCKET_LAST="$NOW"

    if [ "$DECRYPT_BUCKET_TOKENS" -lt 1000 ]; then
        save_state
        return 1
    fi

    DECRYPT_BUCKET_TOKENS=$((DECRYPT_BUCKET_TOKENS - 1000))
    save_state
    return 0
}

function path_is_within() {
    local PARENT="$1"
    local CHILD="$2"
    [ "$CHILD" = "$PARENT" ] || [[ "$CHILD" == "$PARENT/"* ]]
}

function path_uses_links() {
    local FILE_PATH="$1"
    local CURRENT="$FILE_PATH"
    while [ "$CURRENT" != "$PASSWORD_STORE_DIR" ] && [ "$CURRENT" != "/" ]; do
        if [ -L "$CURRENT" ]; then
            return 0
        fi
        CURRENT="$(dirname "$CURRENT")"
    done
    [ -L "$PASSWORD_STORE_DIR" ]
}

function validate_decrypt_path_policy() {
    local FILE_PATH="$1"
    if ! path_uses_links "$FILE_PATH"; then
        return 0
    fi
    local ALLOW_LINKS="$(jq -r '.allowLinks' <<< "$CONFIG")"
    if [ "$ALLOW_LINKS" != "true" ]; then
        return 1
    fi
    local REAL_PATH
    if ! REAL_PATH="$(readlink -f "$FILE_PATH" 2>/dev/null)"; then
        return 1
    fi
    local REAL_PASSDIR="$(jq -r '.realPassdir' <<< "$CONFIG")"
    if path_is_within "$REAL_PASSDIR" "$REAL_PATH"; then
        return 0
    fi
    local ALLOW_EXTERNAL_LINKS="$(jq -r '.allowExternalLinks' <<< "$CONFIG")"
    [ "$ALLOW_EXTERNAL_LINKS" = "true" ]
}

# decrypt and return the contents of a password entry
function action_decrypt() {
    update_config
    local FILE_PATH="$(jq -r '.path' <<< "$1")"
    local INTENT="$(jq -r '.intent' <<< "$1")"
    local ORIGIN="$(jq -r '.origin' <<< "$1")"
    if ! check_decrypt_rate_limit; then
        audit_decrypt "$FILE_PATH" "Denied (rate limit)" "$INTENT" "$ORIGIN"
        parcel_error "Decryption rate limit exceeded"
        return 0
    fi
    local ALLOW=0
    local OUT
    for ALLOWED in "${ALLOWED_FILES[@]}"; do
        if [ "$ALLOWED" = "$FILE_PATH" ]; then
            ALLOW=1
            break
        fi
    done
    if [ $ALLOW -ne 1 ]; then
        audit_decrypt "$FILE_PATH" "Denied (path out of scope)" "$INTENT" "$ORIGIN"
        parcel_error "Access Denied: Path out of scope: $FILE_PATH"
        return 0
    fi
    # passkey entries carry private key material and must never be returned as plaintext
    local PASSKEY
    for PASSKEY in "${PASSKEY_FILES[@]}"; do
        if [ "$PASSKEY" = "$FILE_PATH" ]; then
            audit_decrypt "$FILE_PATH" "Denied (passkey entry)" "$INTENT" "$ORIGIN"
            parcel_error "Access Denied: Passkey entries may not be decrypted: $FILE_PATH"
            return 0
        fi
    done
    if [ ! -f "$FILE_PATH" ]; then
        audit_decrypt "$FILE_PATH" "File not found" "$INTENT" "$ORIGIN"
        parcel_error "File not found: $FILE_PATH"
        return 0
    fi
    if ! validate_decrypt_path_policy "$FILE_PATH"; then
        audit_decrypt "$FILE_PATH" "Denied (path out of scope)" "$INTENT" "$ORIGIN"
        parcel_error "Access Denied: Path out of scope: $FILE_PATH"
        return 0
    fi
    if ! OUT="$(gpg --decrypt --quiet --batch --no-tty --yes --output - < "$FILE_PATH" 2>/dev/null)"; then
        audit_decrypt "$FILE_PATH" "Decryption failed" "$INTENT" "$ORIGIN"
        parcel_error "Failed to decrypt $FILE_PATH"
        return 0
    fi
    # entries in passkey format must never be returned as plaintext under any
    # classification - the content marker is the authoritative backstop for the
    # rule-based check above. Prefix-match the marker so that future format
    # versions are refused by this host version too
    if [[ "$(head -n 1 <<< "$OUT")" == "#!parcel-passkey "* ]]; then
        audit_decrypt "$FILE_PATH" "Denied (passkey content)" "$INTENT" "$ORIGIN"
        parcel_error "Access Denied: Passkey entries may not be decrypted: $FILE_PATH"
        return 0
    fi
    audit_decrypt "$FILE_PATH" "Success" "$INTENT" "$ORIGIN"
    parcel_send "$(jq -n --arg path "$FILE_PATH" --rawfile plaintext <(printf '%s' "$OUT") '{path: $path, plaintext: $plaintext}')"
}

# audit a passkey operation which does not itself decrypt an entry
function audit_passkey() {
    local SHOULD_AUDIT="$(jq -r '.auditDecrypt' <<< "$CONFIG")"
    if [ "$SHOULD_AUDIT" != "true" ]; then
        return 0
    fi
    local EVENT="${1//[[:cntrl:]]/}"
    local ORIGIN="${2//[[:cntrl:]]/}"
    local ENTRY_PATH="${3//[[:cntrl:]]/}"
    local TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    echo "[$TIMESTAMP] PASSKEY ${EVENT:0:128} ${ORIGIN:0:1024} ${ENTRY_PATH:0:1024}" >&5
}

# perform a WebAuthn passkey ceremony (assertion signing, or credential creation)
function action_passkey() {
    update_config
    local OP="$(jq -r '.op' <<< "$1")"
    local RP_ID="$(jq -r '.rpId // empty' <<< "$1")"
    local ORIGIN="$(jq -r '.origin' <<< "$1")"

    if ! command -v openssl &>/dev/null; then
        parcel_error "Cannot find openssl (${OPENSSL:-openssl}): Please configure the correct path for it in parcelrc"
        return 0
    fi
    if [[ ! "$RP_ID" =~ ^[a-z0-9][a-z0-9.-]{0,252}$ ]] || [[ "$RP_ID" == *..* ]]; then
        parcel_error "Invalid relying party id: $RP_ID"
        return 0
    fi

    case "$OP" in
        get)
            passkey_op_get "$1" "$ORIGIN";;
        create)
            passkey_op_create "$1" "$ORIGIN";;
        *)
            parcel_error "Invalid passkey operation: $OP";;
    esac
}

# sign a WebAuthn assertion using the private key stored in a passkey entry
function passkey_op_get() {
    local FILE_PATH="$(jq -r '.path' <<< "$1")"
    local ORIGIN="$2"
    local CLIENT_DATA="$(jq -r '.clientDataJSON' <<< "$1")"
    if ! check_decrypt_rate_limit; then
        audit_decrypt "$FILE_PATH" "Denied (rate limit)" "passkey" "$ORIGIN"
        parcel_error "Decryption rate limit exceeded"
        return 0
    fi
    local ALLOW=0
    for ALLOWED in "${ALLOWED_FILES[@]}"; do
        if [ "$ALLOWED" = "$FILE_PATH" ]; then
            ALLOW=1
            break
        fi
    done
    if [ $ALLOW -ne 1 ]; then
        audit_decrypt "$FILE_PATH" "Denied (path out of scope)" "passkey" "$ORIGIN"
        parcel_error "Access Denied: Path out of scope: $FILE_PATH"
        return 0
    fi
    # only entries classified as passkeys by the config may be used to sign assertions
    local IS_PASSKEY=0
    local PASSKEY
    for PASSKEY in "${PASSKEY_FILES[@]}"; do
        if [ "$PASSKEY" = "$FILE_PATH" ]; then
            IS_PASSKEY=1
            break
        fi
    done
    if [ $IS_PASSKEY -ne 1 ]; then
        audit_decrypt "$FILE_PATH" "Denied (not a passkey entry)" "passkey" "$ORIGIN"
        parcel_error "Access Denied: Not a passkey entry: $FILE_PATH"
        return 0
    fi
    if [ ! -f "$FILE_PATH" ]; then
        audit_decrypt "$FILE_PATH" "File not found" "passkey" "$ORIGIN"
        parcel_error "File not found: $FILE_PATH"
        return 0
    fi
    if ! validate_decrypt_path_policy "$FILE_PATH"; then
        audit_decrypt "$FILE_PATH" "Denied (path out of scope)" "passkey" "$ORIGIN"
        parcel_error "Access Denied: Path out of scope: $FILE_PATH"
        return 0
    fi
    if [[ ! "$CLIENT_DATA" =~ ^[A-Za-z0-9+/]*={0,2}$ ]]; then
        audit_decrypt "$FILE_PATH" "Denied (invalid client data)" "passkey" "$ORIGIN"
        parcel_error "Invalid clientDataJSON encoding"
        return 0
    fi

    local ENTRY
    if ! ENTRY="$(gpg --decrypt --quiet --batch --no-tty --yes --output - < "$FILE_PATH" 2>/dev/null)"; then
        audit_decrypt "$FILE_PATH" "Decryption failed" "passkey" "$ORIGIN"
        parcel_error "Failed to decrypt $FILE_PATH"
        return 0
    fi
    ENTRY="${ENTRY//$'\r'/}"

    local FIRST_LINE="${ENTRY%%$'\n'*}"
    if [ "$FIRST_LINE" != "#!parcel-passkey v1" ]; then
        audit_decrypt "$FILE_PATH" "Denied (missing or unsupported passkey header)" "passkey" "$ORIGIN"
        parcel_error "Malformed passkey entry (missing or unsupported #!parcel-passkey header): $FILE_PATH"
        return 0
    fi
    local ENTRY_RPID="$(printf '%s\n' "$ENTRY" | sed -n 's/^rpId: //p' | head -n1)"
    if [ "$ENTRY_RPID" != "$RP_ID" ]; then
        audit_decrypt "$FILE_PATH" "Denied (rpId mismatch)" "passkey" "$ORIGIN"
        parcel_error "Access Denied: Entry rpId does not match request"
        return 0
    fi
    local ENTRY_ALGORITHM="$(printf '%s\n' "$ENTRY" | sed -n 's/^algorithm: //p' | head -n1)"
    if [ "$ENTRY_ALGORITHM" != "ES256" ]; then
        audit_decrypt "$FILE_PATH" "Denied (unsupported algorithm)" "passkey" "$ORIGIN"
        parcel_error "Access Denied: Unsupported or missing algorithm in passkey entry"
        return 0
    fi
    local CRED_ID="$(printf '%s\n' "$ENTRY" | sed -n 's/^credentialId: //p' | head -n1)"
    local USER_HANDLE="$(printf '%s\n' "$ENTRY" | sed -n 's/^userHandle: //p' | head -n1)"
    if [[ ! "$CRED_ID" =~ ^[A-Za-z0-9_-]{1,86}$ ]]; then
        audit_decrypt "$FILE_PATH" "Denied (invalid credential id)" "passkey" "$ORIGIN"
        parcel_error "Invalid credentialId in passkey entry: $FILE_PATH"
        return 0
    fi
    # when the relying party supplied allowCredentials, the entry's credential must be among them;
    # the presence check is on the raw request array, not the filtered result, so that an
    # all-malformed list still constrains the ceremony (privacy: allowCredentials exists to
    # prevent credential enumeration, so a rejected credential must never be signed)
    local HAS_ALLOW_CREDENTIALS
    HAS_ALLOW_CREDENTIALS="$(jq -r 'if (.allowCredentials | type) == "array" and length > 0 then "yes" else "no" end' <<< "$1" 2>/dev/null)"
    local ALLOW_CREDENTIALS
    ALLOW_CREDENTIALS="$(jq -r '(if (.allowCredentials | type) == "array" then .allowCredentials else [] end)[] | select(test("^[A-Za-z0-9_-]{1,86}$"))' <<< "$1" 2>/dev/null)"
    if [ "$HAS_ALLOW_CREDENTIALS" == "yes" ]; then
        local CRED_ALLOWED=0
        while IFS= read -r ALLOWED_CRED; do
            if [ "$ALLOWED_CRED" = "$CRED_ID" ]; then
                CRED_ALLOWED=1
                break
            fi
        done <<< "$ALLOW_CREDENTIALS"
        if [ "$CRED_ALLOWED" -ne 1 ]; then
            audit_decrypt "$FILE_PATH" "Denied (credential not allowed)" "passkey" "$ORIGIN"
            parcel_error "Access Denied: Credential not allowed by request"
            return 0
        fi
    fi
    if [[ -n "$USER_HANDLE" && ! "$USER_HANDLE" =~ ^[A-Za-z0-9_-]{1,86}$ ]]; then
        audit_decrypt "$FILE_PATH" "Denied (invalid user handle)" "passkey" "$ORIGIN"
        parcel_error "Invalid userHandle in passkey entry: $FILE_PATH"
        return 0
    fi
    local PRIV_PEM
    PRIV_PEM="$(printf '%s\n' "$ENTRY" | awk '/^-----BEGIN PRIVATE KEY-----/{f=1} f{print} /^-----END PRIVATE KEY-----/{exit}')"
    if [[ "$PRIV_PEM" != "-----BEGIN PRIVATE KEY-----"* ]] || [[ "$PRIV_PEM" != *"-----END PRIVATE KEY-----" ]]; then
        audit_decrypt "$FILE_PATH" "Denied (missing private key)" "passkey" "$ORIGIN"
        parcel_error "Missing private key in passkey entry: $FILE_PATH"
        return 0
    fi

    # binary material must stream through pipes; bash variables cannot hold NUL bytes
    local AUTHDATA_B64
    AUTHDATA_B64="$({ printf '%s' "$RP_ID" | openssl dgst -sha256 -binary; printf '\x1d\x00\x00\x00\x00'; } | openssl base64 | tr -d '\n')"
    local SIG_B64
    # NB: base64 decoding requires -A for single-line input - without it openssl silently yields nothing
    SIG_B64="$({ printf '%s' "$AUTHDATA_B64" | openssl base64 -d -A; printf '%s' "$CLIENT_DATA" | openssl base64 -d -A | openssl dgst -sha256 -binary; } 2>/dev/null | openssl dgst -sha256 -sign <(printf '%s\n' "$PRIV_PEM") 2>/dev/null | openssl base64 | tr -d '\n')"
    if [ -z "$SIG_B64" ]; then
        audit_decrypt "$FILE_PATH" "Signing failed" "passkey" "$ORIGIN"
        parcel_error "Failed to sign passkey assertion"
        return 0
    fi
    audit_decrypt "$FILE_PATH" "Success" "passkey" "$ORIGIN"
    parcel_send "$(jq -n \
        --arg credentialId "$CRED_ID" \
        --arg authenticatorData "$AUTHDATA_B64" \
        --arg signature "$SIG_B64" \
        --arg userHandle "$USER_HANDLE" \
        '{op: "get", credentialId: $credentialId, authenticatorData: $authenticatorData, signature: $signature, userHandle: $userHandle}')"
}

# generate a new ES256 passkey and return it encrypted to the store's .gpg-id recipients
function passkey_op_create() {
    local ORIGIN="$2"
    local USER_HANDLE="$(jq -r '.userHandle' <<< "$1")"
    local USER_NAME="$(jq -r '.userName' <<< "$1")"
    local USER_DISPLAY="$(jq -r '.userDisplayName' <<< "$1")"
    local SUGGESTED="$(jq -r '.path' <<< "$1")"
    local PASSKEY_DIR="$(jq -r '.passkeyDir // "passkeys"' <<< "$CONFIG")"

    if [[ ! "$USER_HANDLE" =~ ^[A-Za-z0-9_-]{1,86}$ ]]; then
        parcel_error "Invalid user handle"
        return 0
    fi
    # the passkey directory anchor is user-controlled; control characters would
    # break the single-line audit format, and glob metacharacters must never
    # appear where path prefixes are compared so the checks below stay literal
    # at every current and future call site
    if [[ -z "$PASSKEY_DIR" || "$PASSKEY_DIR" =~ [[:cntrl:]] || "$PASSKEY_DIR" =~ [\*\?\[\\] ]]; then
        audit_passkey "Denied (invalid passkeyDir)" "$ORIGIN" ""
        parcel_error "Invalid passkeyDir in config: $PASSKEY_DIR"
        return 0
    fi
    # the suggested path is advice only - parcel never writes entry files itself;
    # the anchor itself may point anywhere the user configured, but the
    # page-influenced tail ($RP_ID/<basename>) must not traverse past it; $RP_ID
    # was already restricted to hostname syntax by action_passkey
    if [[ "$SUGGESTED" != "$PASSKEY_DIR/$RP_ID/"* ]]; then
        parcel_error "Invalid suggested path: $SUGGESTED"
        return 0
    fi
    local TAIL="${SUGGESTED#"$PASSKEY_DIR/"}"
    if [[ "$TAIL" == *..* ]]; then
        parcel_error "Invalid suggested path: $SUGGESTED"
        return 0
    fi
    local BASENAME="${SUGGESTED##*/}"
    if [[ ! "$BASENAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\.gpg$ ]]; then
        parcel_error "Invalid suggested path: $SUGGESTED"
        return 0
    fi
    # strip control characters + limit lengths on anything page-supplied
    USER_NAME="${USER_NAME//[[:cntrl:]]/}"
    USER_NAME="${USER_NAME:0:128}"
    USER_DISPLAY="${USER_DISPLAY//[[:cntrl:]]/}"
    USER_DISPLAY="${USER_DISPLAY:0:128}"

    # generate the keypair; coordinates are extracted as hex text from the DER encoding
    local PRIV_PEM
    PRIV_PEM="$(openssl ecparam -name prime256v1 -genkey -noout 2>/dev/null | openssl pkcs8 -topk8 -nocrypt 2>/dev/null)"
    if [[ "$PRIV_PEM" != "-----BEGIN PRIVATE KEY-----"* ]]; then
        parcel_error "Failed to generate passkey"
        return 0
    fi
    local PUB_HEX
    PUB_HEX="$(printf '%s\n' "$PRIV_PEM" | openssl ec -pubout -outform DER 2>/dev/null | tail -c 64 | od -An -tx1 | tr -d ' \n')"
    local SPKI_B64
    SPKI_B64="$(printf '%s\n' "$PRIV_PEM" | openssl ec -pubout -outform DER 2>/dev/null | openssl base64 | tr -d '\n')"
    if [ ${#PUB_HEX} -ne 128 ] || [ -z "$SPKI_B64" ]; then
        parcel_error "Failed to generate passkey public key"
        return 0
    fi
    local CRED_ID
    CRED_ID="$(head -c 32 /dev/urandom | openssl base64 | tr -d '\n' | tr '+/' '-_' | tr -d '=')"

    # normalize the store root so a trailing slash cannot break containment checks
    local STORE_ROOT="$PASSWORD_STORE_DIR"
    while [ "$STORE_ROOT" != "/" ] && [ "$STORE_ROOT" != "${STORE_ROOT%/}" ]; do
        STORE_ROOT="${STORE_ROOT%/}"
    done

    # locate the applicable .gpg-id by walking up from the suggested directory (mimics pass);
    # the walk is textual (dirname chops the path string - symlinks resolve only in the -f
    # test), so every chain from "$STORE_ROOT/<anything>" passes through exactly $STORE_ROOT
    # before terminating and the root .gpg-id is always consulted as the final fallback
    local SUGGESTED_FULL="$STORE_ROOT/$SUGGESTED"
    local DIR="$(dirname "$SUGGESTED_FULL")"
    local GPG_ID=""
    while true; do
        if [ -f "$DIR/.gpg-id" ]; then
            GPG_ID="$DIR/.gpg-id"
            break
        fi
        if [ "$DIR" == "$STORE_ROOT" ] || [ "$DIR" == "/" ]; then
            break
        fi
        DIR="$(dirname "$DIR")"
    done
    if [[ "$GPG_ID" != "$STORE_ROOT"/* ]]; then
        # refuse to encrypt for recipient files outside the password store
        GPG_ID=""
    fi
    if [ -z "$GPG_ID" ]; then
        audit_passkey "Denied (no .gpg-id found)" "$ORIGIN" "$SUGGESTED_FULL"
        parcel_error "No .gpg-id found for $SUGGESTED"
        return 0
    fi
    local RECIP_ARGS=()
    local RECIPIENT
    while IFS= read -r RECIPIENT; do
        RECIPIENT="${RECIPIENT%%#*}"
        # trim leading/trailing whitespace; interior whitespace is significant
        # for recipient forms such as "Name <user@example.com>"
        RECIPIENT="${RECIPIENT#"${RECIPIENT%%[![:space:]]*}"}"
        RECIPIENT="${RECIPIENT%"${RECIPIENT##*[![:space:]]}"}"
        if [ -n "$RECIPIENT" ]; then
            RECIP_ARGS+=("-r" "$RECIPIENT")
        fi
    done < "$GPG_ID"
    if [ ${#RECIP_ARGS[@]} -eq 0 ]; then
        audit_passkey "Denied (.gpg-id has no recipients)" "$ORIGIN" "$SUGGESTED_FULL"
        parcel_error "No encryption recipients in $GPG_ID"
        return 0
    fi

    local ENTRY="\
#!parcel-passkey v1
rpId: $RP_ID
credentialId: $CRED_ID
algorithm: ES256
userHandle: $USER_HANDLE
userName: $USER_NAME
userDisplayName: $USER_DISPLAY
publicKey: $PUB_HEX
privateKey:
$PRIV_PEM"

    local ARMORED
    if ! ARMORED="$(printf '%s\n' "$ENTRY" | gpg --batch --yes --quiet --no-tty --armor --trust-model always "${RECIP_ARGS[@]}" --encrypt 2>/dev/null)" || [[ "$ARMORED" != "-----BEGIN PGP MESSAGE-----"* ]]; then
        audit_passkey "Encryption failed" "$ORIGIN" "$SUGGESTED_FULL"
        parcel_error "Failed to encrypt passkey entry to $GPG_ID recipients"
        return 0
    fi
    audit_passkey "Credential created" "$ORIGIN" "$SUGGESTED_FULL"
    parcel_send "$(jq -n \
        --arg credentialId "$CRED_ID" \
        --arg publicKey "$PUB_HEX" \
        --arg spki "$SPKI_B64" \
        --arg path "$SUGGESTED" \
        --arg file "$SUGGESTED_FULL" \
        --arg armored "$ARMORED" \
        '{op: "create", credentialId: $credentialId, publicKey: $publicKey, spki: $spki, path: $path, file: $file, armored: $armored}')"
}
