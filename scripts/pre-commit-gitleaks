#!/usr/bin/env bash
# Parcel pre-commit hook: scan staged changes for secrets with gitleaks.
#
# If gitleaks is not installed, it is downloaded on first run into
#   ~/.cache/parcel-gitleaks/  (or $XDG_CACHE_HOME/parcel-gitleaks/)
# and reused thereafter. To bypass for a specific commit, run
#   git commit --no-verify
#
# Install (from repo root):
#   ln -sf ../../scripts/pre-commit-gitleaks .git/hooks/pre-commit
#   chmod +x scripts/pre-commit-gitleaks

set -euo pipefail

# --- locate repo root -------------------------------------------------------
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || {
    echo "pre-commit-gitleaks: not inside a git repository" >&2
    exit 1
})"

config="$repo_root/.gitleaks.toml"

# --- resolve gitleaks binary ------------------------------------------------
gitleaks_bin="$(command -v gitleaks 2>/dev/null || true)"

if [[ -z "$gitleaks_bin" ]]; then
    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/parcel-gitleaks"
    gitleaks_bin="$cache_dir/gitleaks"

    if [[ ! -x "$gitleaks_bin" ]]; then
        echo "pre-commit-gitleaks: gitleaks not found on PATH; downloading..." >&2
        mkdir -p "$cache_dir"

        # Pick the asset for the host arch/os.
        case "$(uname -s)" in
            Linux*)  os="linux" ;;
            Darwin*) os="darwin" ;;
            *) echo "pre-commit-gitleaks: unsupported OS $(uname -s)" >&2; exit 1 ;;
        esac
        case "$(uname -m)" in
            x86_64|amd64) arch="x64" ;;
            arm64|aarch64) arch="arm64" ;;
            *) echo "pre-commit-gitleaks: unsupported arch $(uname -m)" >&2; exit 1 ;;
        esac

        # Pinned version and SHA-256 checksums per os/arch.
        # When the Makefile DEPS_INSTALL_CUTOFF is updated, this pin and
        # checksums should be updated to match (pick the latest release
        # at or before the new cutoff; verify checksums from the GitHub
        # release).
        version="8.30.1"
        declare -A checksums=(
            ["linux_x64"]="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
            ["linux_arm64"]="e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"
            ["darwin_x64"]="dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709"
            ["darwin_arm64"]="b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5"
        )
        key="${os}_${arch}"
        expected="${checksums[$key]:-}"
        if [[ -z "$expected" ]]; then
            echo "pre-commit-gitleaks: no checksum for $key" >&2
            exit 1
        fi

        asset="gitleaks_${version}_${os}_${arch}.tar.gz"
        url="https://github.com/gitleaks/gitleaks/releases/download/v${version}/${asset}"
        echo "pre-commit-gitleaks: fetching $url" >&2
        tarball="$(mktemp)"
        trap 'rm -f "$tarball"' EXIT
        if ! curl -fsSL "$url" -o "$tarball"; then
            echo "pre-commit-gitleaks: download failed" >&2
            exit 1
        fi
        actual="$(sha256sum "$tarball" | awk '{print $1}')"
        if [[ "$actual" != "$expected" ]]; then
            echo "pre-commit-gitleaks: checksum mismatch for $asset (expected $expected, got $actual)" >&2
            exit 1
        fi
        tar -xz -C "$cache_dir" -f "$tarball" gitleaks
        rm -f "$tarball"
        trap - EXIT
        chmod +x "$gitleaks_bin"
        echo "pre-commit-gitleaks: installed v${version} to $gitleaks_bin" >&2
    fi
fi

# --- run gitleaks against staged changes ------------------------------------
# `protect --staged` is deprecated in recent gitleaks v8 releases but still
# functional; `--redact` keeps matched secrets out of the terminal output.
# `--staged` scopes the scan to the diff being committed. A non-zero exit
# blocks the commit.
exec "$gitleaks_bin" protect \
    --config "$config" \
    --source "$repo_root" \
    --staged \
    --redact \
    --verbose
